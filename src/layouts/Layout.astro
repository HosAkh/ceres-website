---
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';
import '../styles/global.css';
import '../styles/fonts.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'Ceres Technology | AI Supply Chain Intelligence Platform',
  description = 'Ceres connects your ERP and supply chain data to live external signals so your team can predict disruptions before they hit. Enterprise AI with 94% forecast accuracy.',
  ogImage = 'https://cerestech.co/images/logo.png',
  noindex = false,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ceres Technology',
  description: 'AI-powered S&OP planning engine that ingests demand signals, layers on 10B+ external signals, reconciles plans, and flags exceptions before the cycle closes — for Tier 1 Automotive and enterprise supply chain teams.',
  url: 'https://cerestech.co/',
  logo: 'https://cerestech.co/images/logo.png',
  founder: [
    { '@type': 'Person', name: 'Bobby Katoli', jobTitle: 'Co-Founder & CEO' },
    { '@type': 'Person', name: 'Trey Hoobler', jobTitle: 'Co-Founder' },
  ],
  employee: [
    { '@type': 'Person', name: 'Carlos Amaral', jobTitle: 'EVP & CIO' },
  ],
  knowsAbout: [
    'S&OP Planning Automation',
    'Demand Signal Reconciliation',
    'Supply Chain Intelligence',
    'Predictive Analytics',
    'Enterprise AI',
    'Tier 1 Automotive Supply Chain',
    'ERP Integration',
    'Pharmaceutical Supply Chain',
    'Investment Research Intelligence',
  ],
  areaServed: 'Worldwide',
  contactPoint: {
    '@type': 'ContactPoint',
    url: 'https://cerestech.co/book-a-demo/',
    contactType: 'sales',
  },
  sameAs: [
    'https://www.linkedin.com/company/ceres-technology/',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ceres Technology',
  url: 'https://cerestech.co/',
  description: 'AI S&OP planning engine for Tier 1 Automotive and enterprise supply chain teams.',
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ceres',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'AI planning engine that sits between your ERP and decisions. Ingests customer demand signals, reconciles against your plan, layers 10B+ external signals, forecasts every grain, and flags exceptions before the cycle closes.',
  offers: {
    '@type': 'Offer',
    url: 'https://cerestech.co/book-a-demo/',
    availability: 'https://schema.org/InStock',
  },
};
---

<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}icons/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}icons/favicon-192x192.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icons/apple-touch-icon.png`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ceres Technology" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wrkl5jndm6");
    </script>
    <!-- End Microsoft Clarity -->

    <!-- Preconnect for remaining third-party origins -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <!-- Google Tag Manager — dataLayer queues events before GTM loads -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JQLKBQXHKB');
    </script>
    <!-- GTM and GA4 scripts deferred to after page load so they never block rendering -->
    <script is:inline>
      function loadAnalytics() {
        // GTM
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-PNFNBQRT');
        // GA4
        var s=document.createElement('script');
        s.async=true;
        s.src='https://www.googletagmanager.com/gtag/js?id=G-JQLKBQXHKB';
        document.head.appendChild(s);
      }
      if (document.readyState === 'complete') {
        loadAnalytics();
      } else {
        window.addEventListener('load', loadAnalytics);
      }
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="selection:bg-primary selection:text-on-primary">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNFNBQRT"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Navigation client:idle currentPath={Astro.url.pathname} />
    <slot />
    <Footer />
    <!-- Sienna accessibility widget: desktop only (768px+) -->
    <!-- matchMedia does not trigger a layout flush; window.innerWidth does -->
    <script is:inline>
      if (window.matchMedia('(min-width: 768px)').matches) {
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/sienna-accessibility@latest/dist/sienna-accessibility.umd.js';
        s.defer = true;
        document.body.appendChild(s);
      }
    </script>
  </body>
</html>
