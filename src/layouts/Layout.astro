---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/fonts.css';
import barlowCondensed800 from '../fonts/barlow-condensed-800.woff2?url';
import barlow400 from '../fonts/barlow-400.woff2?url';
import dmMono400 from '../fonts/dm-mono-400.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  extraSchema?: Record<string, unknown>;
}

const {
  title = 'Ceres Technology | AI Supply Chain Intelligence Platform',
  description = 'Ceres connects your ERP and supply chain data to live external signals so your team can predict disruptions before they hit. Enterprise AI with 94% forecast accuracy.',
  ogImage = 'https://cerestech.co/images/logo.png',
  noindex = false,
  extraSchema,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;

const globalSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://cerestech.co/#organization',
      name: 'Ceres Technology',
      url: 'https://cerestech.co/',
      logo: 'https://cerestech.co/images/logo.png',
      sameAs: ['https://www.linkedin.com/company/ceres-technology/'],
      description: 'Ceres Technology provides AI S&OP planning software that reconciles ERP records, customer demand signals, and external market signals into decision-ready supply chain plans.',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://cerestech.co/#website',
      url: 'https://cerestech.co/',
      name: 'Ceres Technology',
      publisher: { '@id': 'https://cerestech.co/#organization' },
      inLanguage: 'en-US',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://cerestech.co/#software',
      name: 'Ceres',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web-based',
      url: 'https://cerestech.co/',
      publisher: { '@id': 'https://cerestech.co/#organization' },
      description: 'Ceres is an AI planning engine for S&OP and supply chain teams. It reconciles ERP data, customer demand signals, and external signals into one plan and flags exceptions before planning cycles close.',
      featureList: [
        'S&OP planning',
        'Demand signal reconciliation',
        'ERP and planning system integration',
        'External signal monitoring',
        'Supply chain exception routing',
        'Scenario planning',
      ],
    },
  ],
};

// Breadcrumb schema for internal pages (not homepage)
const pathname = Astro.url.pathname;
const isHomepage = pathname === '/' || pathname === '/index.html';
const pageName = title.split(' | ')[0];
const breadcrumbSchema = !isHomepage ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cerestech.co/' },
    { '@type': 'ListItem', position: 2, name: pageName, item: canonicalURL || `https://cerestech.co${pathname}` },
  ],
} : null;
---

<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Fonts used above the fold on every page -->
    <link rel="preload" href={barlowCondensed800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmMono400} as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}icons/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}icons/favicon-192x192.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icons/apple-touch-icon.png`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ceres Technology" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {extraSchema && <script type="application/ld+json" set:html={JSON.stringify(extraSchema)} />}

    <!-- Analytics bootstrap: queues are created now; the GTM, GA4, Microsoft Clarity
         and Sienna scripts themselves load on the first user interaction. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JQLKBQXHKB');
      window.clarity = window.clarity || function(){(window.clarity.q = window.clarity.q || []).push(arguments);};
      (function () {
        var loaded = false;
        function add(src, attrs) {
          var s = document.createElement('script');
          s.src = src;
          s.async = true;
          if (attrs) for (var k in attrs) s.setAttribute(k, attrs[k]);
          document.head.appendChild(s);
        }
        function load() {
          if (loaded) return;
          loaded = true;
          // Google Tag Manager
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          add('https://www.googletagmanager.com/gtm.js?id=GTM-PNFNBQRT');
          // GA4
          add('https://www.googletagmanager.com/gtag/js?id=G-JQLKBQXHKB');
          // Microsoft Clarity
          add('https://www.clarity.ms/tag/wrkl5jndm6');
          // Sienna accessibility widget: desktop only (768px+)
          if (window.matchMedia('(min-width: 768px)').matches) {
            add('https://cdn.jsdelivr.net/npm/sienna-accessibility@latest/dist/sienna-accessibility.umd.js', { defer: '' });
          }
        }
        ['scroll', 'pointerdown', 'pointermove', 'keydown', 'touchstart'].forEach(function (type) {
          window.addEventListener(type, load, { once: true, passive: true });
        });
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNFNBQRT"
    height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Navigation currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1" class="pt-14">
      <slot />
    </main>
    <Footer />
  </body>
</html>
