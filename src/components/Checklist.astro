---
import Icon from './Icon.astro';

interface Props {
  items: string[];
  icon?: string;
  cards?: boolean;
  class?: string;
}

const { items, icon = 'check_circle', cards = false, class: className } = Astro.props;
---

<ul class:list={[cards ? 'space-y-3' : 'space-y-4', className]}>
  {
    items.map((item) => (
      <li class:list={['flex items-start gap-3', cards && 'card p-4']}>
        <Icon name={icon} size={20} class="mt-0.5 text-primary" />
        <span class="text-on-surface">{item}</span>
      </li>
    ))
  }
</ul>
