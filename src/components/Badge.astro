---
interface Props {
  tone?: 'primary' | 'muted' | 'error';
  dot?: boolean;
  class?: string;
}

const { tone = 'primary', dot = false, class: className } = Astro.props;
const tones = { primary: 'badge-primary', muted: 'badge-muted', error: 'badge-error' };
---

<span class:list={['badge', tones[tone], className]}>
  {dot && <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-current"></span>}
  <slot />
</span>
