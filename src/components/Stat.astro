---
interface Props {
  value: string;
  label: string;
  size?: 'md' | 'lg';
  accent?: boolean;
  class?: string;
}

const { value, label, size = 'md', accent = false, class: className } = Astro.props;
---

<div class={className}>
  <div class:list={[size === 'lg' ? 'stat-lg' : 'stat', accent && 'text-primary']}>{value}</div>
  <div class="meta mt-2">{label}</div>
</div>
