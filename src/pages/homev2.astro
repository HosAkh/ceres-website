---
import Layout from '../layouts/Layout.astro';

const demoUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL + 'book-a-demo/'
  : import.meta.env.BASE_URL + '/book-a-demo/';
---

<Layout
  title="Ceres Technology | External Signal Intelligence For Planning Teams"
  description="Ceres connects your internal planning and ERP data to live external signals so your team can spot supply, pricing, and demand risk earlier and spend less time reconciling spreadsheets."
>
  <main class="pt-14 bg-surface-container-lowest">

    <section class="relative overflow-hidden border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12 lg:py-24">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_90%_10%,rgba(255,182,145,0.06),transparent_38%)]"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-7">
          <div class="mb-7 inline-flex items-center gap-3 border border-outline-variant/30 bg-surface-container-high/40 px-4 py-2">
            <span class="h-2 w-2 bg-primary"></span>
            <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">External signal intelligence records into your existing stack</span>
          </div>
          <h1 class="mb-8 max-w-3xl font-headline text-5xl font-extrabold leading-[1] tracking-[-0.02em] text-on-surface sm:text-6xl lg:text-7xl">
            See what your ERP cannot, before the problem reaches your team.
          </h1>
          <p class="mb-10 max-w-2xl text-lg font-body leading-[1.65] text-on-surface-variant">
            Ceres connects your internal records to live external signals so you can spot supply, pricing, logistics, and demand risk earlier. Your team spends less time rebuilding spreadsheets and more time making decisions.
          </p>
          <a href={demoUrl} class="inline-flex w-full justify-center bg-primary px-8 py-4 font-mono text-[11px] uppercase tracking-[0.14em] text-on-primary transition-all hover:brightness-110 active:scale-95 sm:w-auto">
            Book a Demo
          </a>
          <div class="mt-12 grid gap-6 sm:grid-cols-3 sm:gap-5">
            <div class="border-l border-primary/80 pl-3">
              <div class="font-mono text-[9px] uppercase tracking-[0.2em] text-on-surface-variant">Use your data</div>
              <p class="mt-2 text-sm font-body leading-relaxed text-on-surface">ERP, planning, purchase order, supplier, and SKU records</p>
            </div>
            <div class="border-l border-primary/80 pl-3">
              <div class="font-mono text-[9px] uppercase tracking-[0.2em] text-on-surface-variant">Add outside context</div>
              <p class="mt-2 text-sm font-body leading-relaxed text-on-surface">Weather, trade, macro, logistics, pricing, and market signals</p>
            </div>
            <div class="border-l border-primary/80 pl-3">
              <div class="font-mono text-[9px] uppercase tracking-[0.2em] text-on-surface-variant">Act earlier</div>
              <p class="mt-2 text-sm font-body leading-relaxed text-on-surface">Score risk, catch exceptions, and test scenarios before the damage is visible internally</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="border border-secondary/40 bg-surface-container p-1 shadow-[0_0_28px_rgba(0,0,0,0.35)]">
            <div class="border border-secondary/25 bg-surface-container-lowest">
              <div class="flex items-center justify-between border-b border-secondary/30 bg-secondary/20 px-4 py-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-on-surface-variant">Live Intelligence Layer</span>
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-secondary">Active</span>
              </div>
              <div class="space-y-5 p-6">
                <div class="border border-outline-variant/25 bg-surface-container p-4">
                  <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-on-surface-variant">Internal records</div>
                  <div class="flex flex-wrap gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface">
                    <span class="border border-outline-variant/30 px-2 py-1">ERP</span>
                    <span class="border border-outline-variant/30 px-2 py-1">Orders</span>
                    <span class="border border-outline-variant/30 px-2 py-1">Suppliers</span>
                    <span class="border border-outline-variant/30 px-2 py-1">SKUs</span>
                  </div>
                </div>
                <div class="flex items-center justify-center">
                  <span class="material-symbols-outlined text-primary">south</span>
                </div>
                <div class="border border-primary/35 bg-primary/5 p-4">
                  <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Ceres</div>
                  <div class="grid grid-cols-2 gap-3 text-sm text-on-surface">
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Risk scoring</div>
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Exception detection</div>
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Forecast support</div>
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Scenario modeling</div>
                  </div>
                </div>
                <div class="flex items-center justify-center">
                  <span class="material-symbols-outlined text-primary">south</span>
                </div>
                <div class="border border-outline-variant/25 bg-surface-container p-4">
                  <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-on-surface-variant">What your team gets</div>
                  <div class="space-y-2 text-sm text-on-surface">
                    <div>Know what needs attention first</div>
                    <div>See the signal behind each recommendation</div>
                    <div>Push decisions back into your existing workflow</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">What stays the same across every case</div>
          <h2 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface">Different industries. The same operational gap.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="bg-surface-container p-6 border-l-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">table_view</span>
            <h3 class="mb-3 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Too Much Manual Reconciliation</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Teams still stitch together spreadsheets, portals, PDFs, and siloed systems to answer questions that should already be clear.</p>
          </div>
          <div class="bg-surface-container p-6 border-l-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">visibility</span>
            <h3 class="mb-3 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Internal Data Lags Reality</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Your internal systems show what has already happened. The signals that explain what is coming usually live somewhere else.</p>
          </div>
          <div class="bg-surface-container p-6 border-l-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">bolt</span>
            <h3 class="mb-3 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Decisions Arrive Too Late</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">When risk is found after the shortage, price spike, or forecast miss is already visible, your team is left managing the damage instead of preventing it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-outline-variant/20 bg-surface-container-low px-6 py-14 lg:px-12 lg:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <div class="mb-2 font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">How Ceres works</div>
            <h2 class="font-headline text-5xl font-extrabold leading-[0.95] tracking-[-0.01em] text-on-surface lg:text-6xl">How Ceres Works</h2>
          </div>
          <div class="pt-1 font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">No rip-and-replace required</div>
        </div>

        <div class="grid lg:grid-cols-3">
          <article class="border-b border-outline-variant/20 px-6 py-7 lg:border-b-0 lg:border-r lg:px-8">
            <div class="mb-2 font-mono text-5xl leading-none text-secondary/70">01</div>
            <h3 class="mb-3 font-headline text-4xl font-bold uppercase leading-[0.95] tracking-[0.01em] text-on-surface">Connect your records</h3>
            <p class="font-body text-base leading-[1.6] text-on-surface-variant">Connect planning, supplier, SKU, purchase order, and operational data your team already relies on.</p>
          </article>

          <article class="border-b border-outline-variant/20 px-6 py-7 lg:border-b-0 lg:border-r lg:px-8">
            <div class="mb-2 font-mono text-5xl leading-none text-secondary/70">02</div>
            <h3 class="mb-3 font-headline text-4xl font-bold uppercase leading-[0.95] tracking-[0.01em] text-on-surface">Layer external signals</h3>
            <p class="font-body text-base leading-[1.6] text-on-surface-variant">Map weather, trade, logistics, commodity, and market signals onto the records that matter to each decision.</p>
          </article>

          <article class="px-6 py-7 lg:px-8">
            <div class="mb-2 font-mono text-5xl leading-none text-secondary/70">03</div>
            <h3 class="mb-3 font-headline text-4xl font-bold uppercase leading-[0.95] tracking-[0.01em] text-on-surface">Prioritize and act</h3>
            <p class="font-body text-base leading-[1.6] text-on-surface-variant">Score risk, catch exceptions, explain why they matter, and move from signal to decision faster.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Core capabilities</div>
          <h2 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface">What teams use Ceres for, regardless of industry.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">warning</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Exception Management</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Catch the changes, anomalies, and exposures that are easy to miss in manual review.</p>
          </div>
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">query_stats</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Risk Scoring</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Rank suppliers, SKUs, facilities, assets, or portfolios so your team knows where to look first.</p>
          </div>
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">fact_check</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Explainable Outputs</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Show the signal behind each flag so planners, operators, and analysts can defend the decision.</p>
          </div>
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">science</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Scenario Modeling</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Test the likely impact of tariffs, shortages, weather shifts, and demand changes before you commit.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-outline-variant/20 bg-surface-container-lowest px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Example cases</div>
          <h2 class="font-headline font-extrabold uppercase tracking-[-0.01em] text-on-surface">The same intelligence layer, adapted to decisions.</h2>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'pharma/' : import.meta.env.BASE_URL + '/pharma/'} class="group relative flex min-h-[280px] flex-col justify-end overflow-hidden border border-outline-variant/30 bg-surface-container p-8 transition-all duration-300">
            <div class="absolute inset-0 z-0 scale-100 bg-[url('https://images.unsplash.com/photo-1587854692152-cbe660dbde88?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover:scale-105"></div>
            <div class="absolute inset-0 z-10 bg-gradient-to-b from-[#03151e]/80 to-[#03151e]/95 transition-colors duration-300 group-hover:from-[#03151e]/70 group-hover:to-[#03151e]/90"></div>
            <div class="relative z-20 flex h-full flex-col justify-between">
              <span class="mb-6 block font-mono text-xs uppercase tracking-widest text-on-surface-variant">Pharma</span>
              <div>
                <h3 class="mb-3 font-headline text-2xl font-bold uppercase leading-tight text-on-surface md:text-3xl">Map external disruption with risk onto orders, and SKUs.</h3>
                <p class="font-body text-sm leading-relaxed text-on-surface-variant md:text-base">Calculate external shock impact on specific SKUs and coordinate with your team faster than ever to respond.</p>
              </div>
            </div>
          </a>

          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'hospitals/' : import.meta.env.BASE_URL + '/hospitals/'} class="group relative flex min-h-[280px] flex-col justify-end overflow-hidden border border-outline-variant/30 bg-surface-container p-8 transition-all duration-300">
            <div class="absolute inset-0 z-0 scale-100 bg-[url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover:scale-105"></div>
            <div class="absolute inset-0 z-10 bg-gradient-to-b from-[#03151e]/80 to-[#03151e]/95 transition-colors duration-300 group-hover:from-[#03151e]/70 group-hover:to-[#03151e]/90"></div>
            <div class="relative z-20 flex h-full flex-col justify-between">
              <span class="mb-6 block font-mono text-xs uppercase tracking-widest text-on-surface-variant">Industrials</span>
              <div>
                <h3 class="mb-3 font-headline text-2xl font-bold uppercase leading-tight text-on-surface md:text-3xl">See upstream supplier and forward resource your floor.</h3>
                <p class="font-body text-sm leading-relaxed text-on-surface-variant md:text-base">Connect external sensors, manufacturing, distribution, and external risk buffers instead of waiting for vendor updates.</p>
              </div>
            </div>
          </a>

          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'cpg/' : import.meta.env.BASE_URL + '/cpg/'} class="group relative flex min-h-[280px] flex-col justify-end overflow-hidden border border-outline-variant/30 bg-surface-container p-8 transition-all duration-300">
            <div class="absolute inset-0 z-0 scale-100 bg-[url('https://images.unsplash.com/photo-1605810230434-7631ac76ec81?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover:scale-105"></div>
            <div class="absolute inset-0 z-10 bg-gradient-to-b from-[#03151e]/80 to-[#03151e]/95 transition-colors duration-300 group-hover:from-[#03151e]/70 group-hover:to-[#03151e]/90"></div>
            <div class="relative z-20 flex h-full flex-col justify-between">
              <span class="mb-6 block font-mono text-xs uppercase tracking-widest text-on-surface-variant">CPG</span>
              <div>
                <h3 class="mb-3 font-headline text-2xl font-bold uppercase leading-tight text-on-surface md:text-3xl">Reconcile planning with weather/event signals.</h3>
                <p class="font-body text-sm leading-relaxed text-on-surface-variant md:text-base">Help your teams quickly walk back from the same external context instead of defending different assumptions.</p>
              </div>
            </div>
          </a>

          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'investment-firms/' : import.meta.env.BASE_URL + '/investment-firms/'} class="group relative flex min-h-[280px] flex-col justify-end overflow-hidden border border-outline-variant/30 bg-surface-container p-8 transition-all duration-300">
            <div class="absolute inset-0 z-0 scale-100 bg-[url('https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover:scale-105"></div>
            <div class="absolute inset-0 z-10 bg-gradient-to-b from-[#03151e]/80 to-[#03151e]/95 transition-colors duration-300 group-hover:from-[#03151e]/70 group-hover:to-[#03151e]/90"></div>
            <div class="relative z-20 flex h-full flex-col justify-between">
              <span class="mb-6 block font-mono text-xs uppercase tracking-widest text-on-surface-variant">Investment Firms</span>
              <div>
                <h3 class="mb-3 font-headline text-2xl font-bold uppercase leading-tight text-on-surface md:text-3xl">Strengthen internal models with external signal overlays.</h3>
                <p class="font-body text-sm leading-relaxed text-on-surface-variant md:text-base">Reduce manual research work, and align analysis closer to market conditions.</p>
              </div>
            </div>
          </a>

          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'enterprise-console/' : import.meta.env.BASE_URL + '/enterprise-console/'} class="group relative flex min-h-[280px] flex-col justify-end overflow-hidden border border-outline-variant/30 bg-surface-container p-8 transition-all duration-300">
            <div class="absolute inset-0 z-0 scale-100 bg-[url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover:scale-105"></div>
            <div class="absolute inset-0 z-10 bg-gradient-to-b from-[#03151e]/80 to-[#03151e]/95 transition-colors duration-300 group-hover:from-[#03151e]/70 group-hover:to-[#03151e]/90"></div>
            <div class="relative z-20 flex h-full flex-col justify-between">
              <span class="mb-6 block font-mono text-xs uppercase tracking-widest text-on-surface-variant">Enterprise Console</span>
              <div>
                <h3 class="mb-3 font-headline text-2xl font-bold uppercase leading-tight text-on-surface md:text-3xl">Give planning teams one place to monitor, catch, and act.</h3>
                <p class="font-body text-sm leading-relaxed text-on-surface-variant md:text-base">Replace spreadsheet distribution with a clearer operational view of the truth.</p>
              </div>
            </div>
          </a>

          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'data-analysis/' : import.meta.env.BASE_URL + '/data-analysis/'} class="group relative flex min-h-[280px] flex-col justify-end overflow-hidden border border-outline-variant/30 bg-surface-container p-8 transition-all duration-300">
            <div class="absolute inset-0 z-0 scale-100 bg-[url('https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?q=80&w=800&auto=format&fit=crop')] bg-cover bg-center transition-transform duration-500 group-hover:scale-105"></div>
            <div class="absolute inset-0 z-10 bg-gradient-to-b from-[#03151e]/80 to-[#03151e]/95 transition-colors duration-300 group-hover:from-[#03151e]/70 group-hover:to-[#03151e]/90"></div>
            <div class="relative z-20 flex h-full flex-col justify-between">
              <span class="mb-6 block font-mono text-xs uppercase tracking-widest text-on-surface-variant">Data Analysis</span>
              <div>
                <h3 class="mb-3 font-headline text-2xl font-bold uppercase leading-tight text-on-surface md:text-3xl">Map external data directly onto internal records for faster analysis.</h3>
                <p class="font-body text-sm leading-relaxed text-on-surface-variant md:text-base">Automatic blending, scaling, and categorization without ongoing analysts stuck in manual routine.</p>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Why teams bring in Ceres</div>
          <h2 class="mb-6 font-headline font-extrabold tracking-[-0.01em] text-on-surface">You do not need to replace your stack to get earlier visibility.</h2>
          <p class="max-w-2xl text-base font-body leading-[1.7] text-on-surface-variant">
            Ceres is an intelligence layer, not a rip-and-replace platform. It fits alongside your ERP, planning tools, and existing workflows so your team can work from better context instead of more dashboards.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="bg-surface-container p-6 border border-outline-variant/20">
            <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Direct fit</div>
            <p class="text-sm font-body leading-[1.7] text-on-surface">Works alongside the systems your team already uses.</p>
          </div>
          <div class="bg-surface-container p-6 border border-outline-variant/20">
            <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">35,000+ indicators</div>
            <p class="text-sm font-body leading-[1.7] text-on-surface">Brings broad external context into a usable operational workflow.</p>
          </div>
          <div class="bg-surface-container p-6 border border-outline-variant/20">
            <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Multi-tier visibility</div>
            <p class="text-sm font-body leading-[1.7] text-on-surface">Go beyond the direct vendor or immediate data source you already know.</p>
          </div>
          <div class="bg-surface-container p-6 border border-outline-variant/20">
            <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Explainable by design</div>
            <p class="text-sm font-body leading-[1.7] text-on-surface">See the signal behind the recommendation before you act on it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-outline-variant/20 bg-surface-container-lowest p-8 lg:p-24">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-xl font-headline font-extrabold uppercase tracking-[-0.01em] mb-12 md:text-2xl">Common Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-x-16">
          <div class="md:max-w-[34rem]">
            <h6 class="text-lg md:text-xl font-headline font-bold uppercase tracking-[0.015em] mb-3 text-primary">How does Ceres handle legacy ERP data?</h6>
            <p class="max-w-none text-sm font-body font-normal text-on-surface-variant leading-[1.7]">Ceres uses universal connectors to pull data from any legacy system without modifying the source.</p>
          </div>
