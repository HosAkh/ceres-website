---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import Stat from '../components/Stat.astro';
import Checklist from '../components/Checklist.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';
import heroNetwork from '../images/hospitals-hero-network.jpg';
import skuMapping from '../images/hospitals-sku-mapping.jpg';
import earlyWarning from '../images/hospitals-early-warning.jpg';
import tariff from '../images/hospitals-tariff.jpg';

const risks = [
  { icon: 'storm', title: 'Natural Disasters', text: 'Hurricanes, floods, and severe weather events that knock out manufacturing facilities weeks before vendors notify customers.' },
  { icon: 'gavel', title: 'Trade & Tariff Shifts', text: 'Country-of-origin changes and tariff policy that affect your cost and availability — tracked at the SKU level, not just headlines.' },
  { icon: 'hub', title: 'Concentration Risk', text: 'SKUs tied to a single manufacturing site or distribution center — the hidden single points of failure in your formulary.' },
];

const capabilities = [
  { image: skuMapping, alt: 'Medical supply warehouse with clinical logistics overlay', title: 'Supplier-to-SKU Mapping', text: 'Automatically link every item in your formulary to its manufacturing location, distribution path, and upstream dependencies. Know which SKUs are exposed before an event hits.' },
  { image: earlyWarning, alt: 'Early warning dashboard with orange radar and clinical data', title: 'Disruption Early Warning', text: 'Receive alerts up to 90 days before your vendor reports a clinical shortage. When a weather event, port shutdown, or facility closure hits your supply chain, Ceres surfaces it first.' },
  { image: tariff, alt: 'Tariff compliance documents with digital data highlights', title: 'Tariff & Compliance Tracking', text: 'Automatically identify HTS codes, countries of origin, and tariff exposure across your formulary. No more analysts going product by product through boxes and PDFs.' },
];

const proof = [
  'Get ahead of shortages by monitoring weather, logistics, and financial risk at the facility level — not the headline level.',
  'Automatically map SKU exposure to countries of origin and tariff classifications — without analysts working through boxes and PDFs.',
  'Replace fragmented point solutions and spreadsheet analysis with a single, integrated risk intelligence layer.',
  'Integrates directly with your existing ERP — no rip-and-replace.',
];
---

<Layout
  title="AI Planning for Hospitals & Health Systems | Ceres"
  description="Ceres helps hospitals and health systems detect formulary risk, shortage exposure, tariff changes, and supplier disruption signals before they affect operations."
>
  <Hero
    eyebrow="Hospitals & Health Systems"
    lead="Ceres gives hospital supply chain teams early warning on procurement disruptions — linking every SKU in your formulary to its manufacturing location, distribution path, and upstream risk factors before the call ever comes."
    cta={{ href: demoUrl, label: 'Book a Demo', arrow: true }}
  >
    By the time your vendor calls, the shortage is already yours to manage
    <Media slot="visual" src={heroNetwork} alt="Hospital supply chain network visualization" class="hidden lg:block" />
  </Hero>

  <Section tone="lowest">
    <SectionHeader align="center" eyebrow="Risk Vectors" lead="The signals that identify a shortage are visible. They're just not inside your four walls.">
      Your ERP tracks what you ordered. It has no idea what's happening upstream.
    </SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        risks.map(({ icon, title, text }, i) => (
          <Card featured={i === 0}>
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-2">{title}</h3>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
          </Card>
        ))
      }
      <Card>
        <Icon name="visibility_off" size={32} class="mb-5 text-primary" />
        <div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-2">
          <h3>Vendor Opacity</h3>
          <Badge>10+ Billion Data Points</Badge>
        </div>
        <p class="text-body-sm text-on-surface-variant">Data points across geopolitical, economic, raw materials, logistics, and other categories, with over 35,000 data categories to identify risk.</p>
      </Card>
    </div>
  </Section>

  <Section tone="low">
    <SectionHeader align="center" lead="Three capabilities your supply chain team can use today that don't require a vendor to call first.">
      From reactive to proactive
    </SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        capabilities.map(({ image, alt, title, text }) => (
          <Card pad="none" class="overflow-hidden">
            <Media src={image} alt={alt} aspect="video" class="border-0" sizes="(min-width: 768px) 33vw, 100vw" />
            <div class="p-6">
              <h3 class="mb-2">{title}</h3>
              <p class="text-body-sm text-on-surface-variant">{text}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section>
    <SectionHeader lead="Transforming reactive purchasing into proactive intelligence.">Where hospitals are using Ceres today</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
      <Card featured class="flex flex-col justify-between md:col-span-8">
        <div>
          <div class="mb-6 flex items-start justify-between gap-4">
            <Badge>Active Risk Flag</Badge>
            <Icon name="analytics" size={24} class="text-primary" />
          </div>
          <h3 class="mb-4 text-title-lg">Formulary Risk Scoring</h3>
          <p class="max-w-lg text-lead text-on-surface-variant">Score every item in your formulary by supplier concentration, geographic risk, and disruption history. When 2,000 SKUs need monitoring, you need to know which 50 are actually exposed today.</p>
        </div>
        <div class="mt-10 flex flex-wrap gap-10 border-t border-outline-variant/30 pt-6">
          <Stat value="300k+" label="SKUs Monitored" accent />
          <Stat value="90 days" label="Early Warning Lead" accent />
        </div>
      </Card>

      <Card class="md:col-span-4">
        <h3 class="mb-5 flex items-center gap-2">
          <Icon name="account_tree" size={22} class="text-primary" />
          Multi-Tier Visibility
        </h3>
        <div class="space-y-4">
          <div>
            <div class="mb-1 flex justify-between text-sm">
              <span class="text-on-surface-variant">Tier 1 Direct</span>
              <span class="font-mono text-primary">100%</span>
            </div>
            <div aria-hidden="true" class="h-1.5 w-full bg-surface-container-high"><div class="h-full bg-primary" style="width: 100%"></div></div>
          </div>
          <div>
            <div class="mb-1 flex justify-between text-sm">
              <span class="text-on-surface-variant">Tier 2 Components</span>
              <span class="font-mono text-primary">64%</span>
            </div>
            <div aria-hidden="true" class="h-1.5 w-full bg-surface-container-high"><div class="h-full bg-primary" style="width: 64%"></div></div>
          </div>
          <p class="pt-2 text-body-sm text-on-surface-variant">See past your distributors into their suppliers — the tier most health systems have zero visibility into.</p>
        </div>
      </Card>

      <Card class="flex flex-col gap-6 md:col-span-8 md:flex-row md:items-center">
        <div class="flex-1 space-y-3">
          <h3>OR & Surgical Supply</h3>
          <p class="text-body-sm text-on-surface-variant">Bring data-driven planning to the service lines that can't afford a stockout — replacing tribal knowledge with structured, auditable intelligence.</p>
          <div>
            <div class="mb-1 flex items-center justify-between">
              <span class="meta">Network Health</span>
              <span class="font-mono text-label uppercase text-primary">Stable</span>
            </div>
            <div aria-hidden="true" class="h-2 w-full bg-surface-container-high"><div class="h-full bg-primary" style="width: 88%"></div></div>
          </div>
        </div>
        <div class="flex aspect-square w-full shrink-0 items-center justify-center border border-outline-variant/20 bg-surface-container-low md:w-40">
          <Icon name="surgical" size={72} class="text-primary/30" />
        </div>
      </Card>
    </div>
  </Section>

  <Section tone="lowest">
    <Card pad="lg" class="relative overflow-hidden">
      <Icon name="health_and_safety" size={220} class="pointer-events-none absolute -bottom-12 -right-12 text-primary/5" />
      <div class="relative grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div class="space-y-8">
          <h2>Stop being dependent on a vendor email that may never come</h2>
          <Checklist items={proof} />
        </div>
        <div aria-hidden="true" class="hidden lg:block">
          <div class="border border-outline-variant/20 bg-surface-container-low p-6">
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center bg-primary/20">
                <Icon name="security" size={16} class="text-primary" />
              </div>
              <span class="meta">Compliance Report v2.4</span>
            </div>
            <div class="space-y-2">
              <div class="h-2 w-3/4 bg-surface-container-high"></div>
              <div class="h-2 w-full bg-surface-container-high"></div>
              <div class="h-2 w-5/6 bg-surface-container-high"></div>
              <div class="mt-6 h-2 w-1/2 bg-primary/30"></div>
            </div>
          </div>
        </div>
      </div>
    </Card>
  </Section>

  <CtaBand href={demoUrl} label="Book a Demo">Know before the shortage reaches your dock</CtaBand>
</Layout>
