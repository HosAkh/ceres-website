---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';

const bottlenecks = [
  { icon: 'engineering', title: 'Trapped Analysts', text: 'Analysts spend all day compiling data instead of using it.', status: 'Status: Critical Drain' },
  { icon: 'map', title: 'Stale Data Artifacts', text: 'Disconnected data creates bottlenecks, leaving less time for decision-making.' },
  { icon: 'find_in_page', title: 'Unstructured Grind', text: 'Manual review of unstructured records does not scale.' },
];

const useCases = [
  { icon: 'inventory', title: 'Supply Risk Scorecards', meta: 'Vendor data' },
  { icon: 'public', title: 'Portfolio Exposure Mapping', meta: 'Geo exposure' },
  { icon: 'track_changes', title: 'Geospatial Audience Targeting', meta: 'Geospatial layer' },
  { icon: 'subject', title: 'Text Categorization', meta: 'NLP Classify' },
  { icon: 'trending_up', title: 'Demand Forecasting', meta: 'Predictive model' },
];
---

<Layout
  title="Data Analysis & External Signal Mapping | Ceres Technology"
  description="Ceres maps geospatial, demographic, and market signals onto your internal records — replacing weeks of manual spreadsheet work with automated scorecards, exposure maps, and record classification."
>
  <Hero
    lead="We help enterprise operations, risk, and planning teams connect their internal systems to real-world geospatial, demographic, and market signals. Ceres automatically merges your data to build scorecards, map exposures, and classify records without weeks of manual spreadsheet work."
    cta={{ href: demoUrl, label: 'Book a Demo', arrow: true }}
  >
    Map external data onto your internal records to automate complex analysis.
    <div slot="visual" class="panel relative min-h-[26rem] overflow-hidden lg:min-h-[30rem]">
      <div aria-hidden="true" class="grid-pattern absolute inset-0"></div>
      <svg aria-hidden="true" class="absolute inset-0 h-full w-full" viewBox="0 0 480 420" preserveAspectRatio="none" fill="none">
        <path d="M 140 130 C 240 130, 240 300, 340 300" class="stroke-primary-container" stroke-dasharray="4 4" stroke-width="2" opacity="0.6"></path>
      </svg>
      <div class="absolute left-[12%] top-[16%] w-44 border border-outline-variant bg-surface-container-high p-4 shadow-[0_4px_20px_rgba(0,0,0,0.5)]">
        <div class="meta mb-1">Internal DB</div>
        <div class="font-headline text-title-sm font-bold text-on-surface">Asset Records</div>
        <div aria-hidden="true" class="mt-2 h-1 w-full bg-surface-container-low"><div class="h-full w-3/4 bg-primary"></div></div>
      </div>
      <div class="absolute bottom-[16%] right-[12%] w-44 border border-outline-variant bg-surface-container-high p-4 shadow-[0_4px_20px_rgba(0,0,0,0.5)]">
        <div class="meta mb-1">Ext. Signal: Weather</div>
        <div class="font-headline text-title-sm font-bold text-on-surface">Weather Data</div>
        <div aria-hidden="true" class="mt-2 flex gap-1">
          <span class="h-2 w-2 bg-primary"></span>
          <span class="h-2 w-2 bg-primary"></span>
          <span class="h-2 w-2 bg-surface-container-low"></span>
        </div>
      </div>
      <div class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center border border-primary bg-surface p-6 shadow-[0_4px_20px_rgba(0,0,0,0.5)]">
        <Icon name="hub" size={32} class="mb-2 text-primary" />
        <div class="eyebrow">Ceres Engine</div>
      </div>
    </div>
  </Hero>

  <Section>
    <div class="flex items-start justify-between gap-6">
      <SectionHeader eyebrow="The bottleneck" lead="Analyzing your records against outside data is a massive manual bottleneck. Your internal assets live in your database, but the external data (weather, demographics, etc.) lives everywhere else.">
        Manual reconciliation holds teams back
      </SectionHeader>
      <Badge tone="error" class="hidden shrink-0 md:inline-flex">ERR: MANUAL_RECONCILIATION</Badge>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        bottlenecks.map(({ icon, title, text, status }) => (
          <Card class="flex flex-col gap-4">
            <div class="flex h-10 w-10 items-center justify-center bg-surface-container-lowest">
              <Icon name={icon} size={24} class="text-on-surface" />
            </div>
            <h3>{title}</h3>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
            {status && <div class="meta mt-auto border-t border-outline-variant/20 pt-4 text-error">{status}</div>}
          </Card>
        ))
      }
    </div>
  </Section>

  <Section tone="lowest">
    <SectionHeader eyebrow="What Ceres does">Connect signals in minutes</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
      <Card class="relative flex min-h-[16rem] flex-col justify-end md:col-span-2 md:row-span-2">
        <Icon name="merge_type" size={40} class="absolute right-6 top-6 text-outline" />
        <h3 class="mb-2">Automate data blending</h3>
        <p class="text-body-sm text-on-surface-variant">Seamlessly merge disparate internal datasets with complex external feeds without writing custom ETL pipelines.</p>
      </Card>
      <Card class="flex flex-col justify-between gap-6 md:col-span-2">
        <div class="flex items-start justify-between gap-4">
          <h3>Overlay external signals</h3>
          <Icon name="layers" size={24} class="text-outline" />
        </div>
        <p class="text-body-sm text-on-surface-variant">Instantly map demographic, geospatial, and market data onto your existing records.</p>
      </Card>
      <Card>
        <Icon name="score" size={32} class="mb-5 text-primary" />
        <h3 class="mb-2">Dynamic Scorecards</h3>
        <p class="text-body-sm text-on-surface-variant">Generate real-time risk and opportunity scores.</p>
      </Card>
      <Card>
        <Icon name="science" size={32} class="mb-5 text-primary" />
        <h3 class="mb-2">What-If Scenarios</h3>
        <p class="text-body-sm text-on-surface-variant">Run simulations based on shifting external variables.</p>
      </Card>
    </div>
  </Section>

  <Section>
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeader eyebrow="Use cases">Replacing spreadsheets</SectionHeader>
      <ButtonLink href={demoUrl} variant="secondary" class="mb-12 self-start lg:mb-16">View all cases</ButtonLink>
    </div>
    <ul class="flex flex-col gap-2">
      {
        useCases.map(({ icon, title, meta }) => (
          <li class="card flex flex-col gap-2 p-4 md:flex-row md:items-center md:justify-between">
            <div class="flex items-center gap-4">
              <Icon name={icon} size={24} class="text-outline" />
              <span class="font-headline text-title-sm font-bold text-on-surface">{title}</span>
            </div>
            <span class="meta hidden md:block">{meta}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="lowest">
    <SectionHeader align="center" eyebrow="Telemetry">Measurable results</SectionHeader>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      <Card class="flex flex-col items-center justify-center text-center">
        <div class="stat mb-2 text-primary">Wk→Min</div>
        <div class="meta">Processing Time</div>
      </Card>
      <Card class="flex flex-col items-center justify-center text-center">
        <div class="mb-2 flex h-11 items-center"><Icon name="bolt" size={36} class="text-on-surface" /></div>
        <div class="meta">Instant Categorization</div>
      </Card>
      <Card class="flex flex-col items-center justify-center text-center">
        <div class="stat mb-2">TB+</div>
        <div class="meta">Massive Scale</div>
      </Card>
      <Card class="flex flex-col items-center justify-center text-center">
        <div class="stat mb-2">API/DB</div>
        <div class="meta">Direct Integration</div>
      </Card>
    </div>
  </Section>

  <CtaBand href={demoUrl} label="Book a Demo" lead="Stop losing days to manual data reconciliation.">
    Ready to see it work with your data?
  </CtaBand>
</Layout>
