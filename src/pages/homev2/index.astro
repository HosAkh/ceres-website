---
import Layout from '../../layouts/Layout.astro';

const demoUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL + 'book-a-demo/'
  : import.meta.env.BASE_URL + '/book-a-demo/';

const industryLinks = {
  pharma: import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'pharma/' : import.meta.env.BASE_URL + '/pharma/',
  hospitals: import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'hospitals/' : import.meta.env.BASE_URL + '/hospitals/',
  cpg: import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'cpg/' : import.meta.env.BASE_URL + '/cpg/',
  investment: import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'investment-firms/' : import.meta.env.BASE_URL + '/investment-firms/',
};
---

<Layout
  title="Home V2 | Ceres Technology"
  description="See what your ERP cannot. Ceres layers external signals onto your records so your team can catch supply, pricing, logistics, and demand risk earlier."
>
  <main class="pt-16 min-h-screen bg-surface text-on-surface overflow-hidden">
    <section class="relative border-b border-outline-variant/20 bg-surface-container-lowest">
      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 20%, rgba(243,114,33,0.18), transparent 28%), linear-gradient(to right, rgba(88,66,55,0.25) 1px, transparent 1px), linear-gradient(to bottom, rgba(88,66,55,0.18) 1px, transparent 1px); background-size: auto, 32px 32px, 32px 32px;"></div>
      <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-primary/10 to-transparent"></div>
      <div class="relative max-w-7xl mx-auto px-6 py-20 lg:py-28 grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(420px,0.95fr)] items-center">
        <div>
          <div class="inline-flex items-center gap-3 border border-primary/20 bg-surface-container/80 px-4 py-2 mb-8">
            <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
            <span class="font-mono text-[11px] tracking-[0.16em] uppercase text-primary">External signal intelligence layered onto your existing stack</span>
          </div>
          <h1 class="max-w-4xl text-on-surface mb-6">
            See what your ERP cannot, before the problem reaches your team.
          </h1>
          <p class="text-lg md:text-xl text-on-surface-variant max-w-2xl mb-8 leading-[1.7]">
            Ceres connects your planning, supplier, purchase order, and SKU records to live weather, trade, logistics, pricing, and geopolitical signals so your team can catch risk earlier and act with context.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center mb-8">
            <a href={demoUrl} class="inline-flex items-center justify-center px-8 py-4 bg-primary text-on-primary font-mono text-[11px] tracking-[0.16em] uppercase shadow-[0_0_30px_rgba(243,114,33,0.2)] hover:brightness-110 transition-all">
              Book a Demo
            </a>
            <div class="text-sm text-on-surface-variant border-l border-outline-variant/40 pl-4">
              No rip-and-replace required. Ceres works alongside your ERP and planning tools.
            </div>
          </div>
          <div class="grid gap-3 sm:grid-cols-3 max-w-3xl">
            <div class="border border-outline-variant/20 bg-surface-container/70 px-4 py-4 backdrop-blur-sm">
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline mb-2">Use your data</div>
              <p class="text-sm text-on-surface-variant max-w-none">ERP, planning, purchase order, supplier, and SKU records.</p>
            </div>
            <div class="border border-outline-variant/20 bg-surface-container/70 px-4 py-4 backdrop-blur-sm">
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline mb-2">Add outside context</div>
              <p class="text-sm text-on-surface-variant max-w-none">Weather, trade, macro, logistics, pricing, and market signals.</p>
            </div>
            <div class="border border-outline-variant/20 bg-surface-container/70 px-4 py-4 backdrop-blur-sm">
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline mb-2">Act earlier</div>
              <p class="text-sm text-on-surface-variant max-w-none">Score risk, catch exceptions, and test scenarios before impact shows internally.</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-4 bg-primary/10 blur-3xl"></div>
          <div class="relative border border-outline-variant/20 bg-surface-container/80 backdrop-blur-md industrial-shadow overflow-hidden">
            <img
              src={`${import.meta.env.BASE_URL}images/ec-hero-dashboard.jpg`}
              alt="Ceres supply chain intelligence dashboard"
              class="absolute inset-0 h-full w-full object-cover opacity-30"
              width="1280"
              height="960"
            />
            <div class="absolute inset-0 bg-gradient-to-br from-surface-container-lowest/90 via-surface/70 to-primary/10"></div>
            <div class="relative p-6 md:p-8">
              <div class="flex items-center justify-between gap-4 border-b border-outline-variant/20 pb-4">
                <div>
                  <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-outline">Live intelligence layer</div>
                  <div class="text-xl font-headline font-bold tracking-[0.01em] text-on-surface mt-2">Active records mapped to upstream risk</div>
                </div>
                <div class="inline-flex items-center gap-2 border border-primary/20 bg-primary/10 px-3 py-2">
                  <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                  <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary">12 live flags</span>
                </div>
              </div>

              <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr] mt-6">
                <div class="border border-outline-variant/20 bg-surface-container-lowest/70 p-5">
                  <div class="flex items-center justify-between mb-4">
                    <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline">Signal map</span>
                    <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary">Updated 2m ago</span>
                  </div>
                  <div class="grid grid-cols-3 gap-3">
                    <div class="border border-outline-variant/20 bg-surface px-3 py-4">
                      <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline">Internal</div>
                      <div class="mt-3 space-y-2 text-sm text-on-surface-variant">
                        <div>ERP</div>
                        <div>Orders</div>
                        <div>Suppliers</div>
                        <div>SKUs</div>
                      </div>
                    </div>
                    <div class="border border-primary/30 bg-primary/10 px-3 py-4 flex items-center justify-center text-center">
                      <div>
                        <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary">CERES</div>
                        <div class="mt-3 text-sm text-on-surface">Risk scoring<br />Exception detection<br />Scenario modeling</div>
                      </div>
                    </div>
                    <div class="border border-outline-variant/20 bg-surface px-3 py-4">
                      <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline">Signals</div>
                      <div class="mt-3 space-y-2 text-sm text-on-surface-variant">
                        <div>Weather</div>
                        <div>Tariffs</div>
                        <div>Port activity</div>
                        <div>Commodities</div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="space-y-4">
                  <div class="border border-outline-variant/20 bg-surface-container-low/80 p-4">
                    <div class="flex items-center justify-between gap-3 mb-3">
                      <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline">Priority queue</span>
                      <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-error">High attention</span>
                    </div>
                    <div class="space-y-3 text-sm">
                      <div class="border-l-2 border-primary pl-3">
                        <div class="text-on-surface font-medium uppercase tracking-[0.04em]">Port congestion</div>
                        <p class="text-on-surface-variant max-w-none">Inbound shipment route delay is rising around a key supplier corridor.</p>
                      </div>
                      <div class="border-l-2 border-outline-variant pl-3">
                        <div class="text-on-surface font-medium uppercase tracking-[0.04em]">Tariff exposure</div>
                        <p class="text-on-surface-variant max-w-none">Two SKUs now map to a newly affected trade lane.</p>
                      </div>
                    </div>
                  </div>

                  <div class="grid sm:grid-cols-2 gap-4">
                    <div class="border border-outline-variant/20 bg-surface-container-low/80 p-4">
                      <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline">Signals monitored</div>
                      <div class="mt-2 text-3xl font-headline font-extrabold text-primary data-mono">35,000+</div>
                    </div>
                    <div class="border border-outline-variant/20 bg-surface-container-low/80 p-4">
                      <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline">Workflow output</div>
                      <div class="mt-2 text-sm text-on-surface">Explainable alerts and decision-ready exception lists.</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-outline-variant/20 bg-surface-container-low px-6 py-6">
      <div class="max-w-7xl mx-auto grid gap-4 md:grid-cols-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">hub</span>
          <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-on-surface-variant">SAP / Oracle / JDA integration</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">public</span>
          <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-on-surface-variant">35,000+ global indicators</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">lan</span>
          <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-on-surface-variant">Multi-tier visibility</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">fact_check</span>
          <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-on-surface-variant">Explainable outputs</span>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 border-b border-outline-variant/20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-12">
          <div class="font-mono text-[11px] tracking-[0.16em] uppercase text-primary mb-4">What stays the same across every case</div>
          <h2 class="text-on-surface mb-5">Different industries. The same operational gap.</h2>
          <p class="text-lg text-on-surface-variant">Teams still spend time stitching together spreadsheets, portals, PDFs, and siloed systems to answer questions that should already be clear.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <article class="border border-outline-variant/20 bg-surface-container p-6 md:col-span-1">
            <span class="material-symbols-outlined text-primary text-3xl mb-5">table_view</span>
            <h3 class="text-on-surface mb-3">Too much manual reconciliation</h3>
            <p class="text-on-surface-variant">Your team rebuilds the same answer from different systems every time a question becomes urgent.</p>
          </article>
          <article class="border border-primary/30 bg-gradient-to-b from-primary/10 to-surface-container p-6 md:col-span-1">
            <span class="material-symbols-outlined text-primary text-3xl mb-5">visibility</span>
            <h3 class="text-on-surface mb-3">Internal data lags reality</h3>
            <p class="text-on-surface-variant">Your ERP shows what has already happened. The signals that explain what is forming usually live somewhere else.</p>
          </article>
          <article class="border border-outline-variant/20 bg-surface-container p-6 md:col-span-1">
            <span class="material-symbols-outlined text-primary text-3xl mb-5">bolt</span>
            <h3 class="text-on-surface mb-3">Decisions arrive too late</h3>
            <p class="text-on-surface-variant">When risk is found after the shortage, price spike, or forecast miss is visible, your team is left managing damage instead of preventing it.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-surface-container-lowest px-6 py-20 border-b border-outline-variant/20">
      <div class="max-w-7xl mx-auto grid gap-12 lg:grid-cols-[0.9fr_1.1fr] items-start">
        <div>
          <div class="font-mono text-[11px] tracking-[0.16em] uppercase text-primary mb-4">How Ceres works</div>
          <h2 class="text-on-surface mb-5">One system for the work your team is doing by hand today.</h2>
          <p class="text-lg text-on-surface-variant">Ceres gives you a clearer path from internal record to external context to action without asking your team to replace the systems they already run.</p>
        </div>
        <div class="space-y-4">
          <div class="border border-outline-variant/20 bg-surface-container p-6 flex gap-5">
            <div class="shrink-0 w-12 h-12 flex items-center justify-center border border-primary/30 text-primary font-mono">01</div>
            <div>
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-outline mb-2">No rip-and-replace required</div>
              <h3 class="text-on-surface mb-2">Connect your records</h3>
              <p class="text-on-surface-variant">Bring in the planning, supplier, SKU, purchase order, and operational data your team already uses.</p>
            </div>
          </div>
          <div class="border border-outline-variant/20 bg-surface-container p-6 flex gap-5">
            <div class="shrink-0 w-12 h-12 flex items-center justify-center border border-primary/30 text-primary font-mono">02</div>
            <div>
              <h3 class="text-on-surface mb-2">Layer external signals</h3>
              <p class="text-on-surface-variant">Map weather, trade, logistics, commodity, geopolitical, and market signals onto the records that matter to your decisions.</p>
            </div>
          </div>
          <div class="border border-outline-variant/20 bg-surface-container p-6 flex gap-5">
            <div class="shrink-0 w-12 h-12 flex items-center justify-center border border-primary/30 text-primary font-mono">03</div>
            <div>
              <h3 class="text-on-surface mb-2">Prioritize and act</h3>
              <p class="text-on-surface-variant">Score risk, flag exceptions, explain why they matter, and give your team a faster path from signal to decision.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 border-b border-outline-variant/20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-12">
          <div class="font-mono text-[11px] tracking-[0.16em] uppercase text-primary mb-4">Core capabilities</div>
          <h2 class="text-on-surface mb-5">What teams use Ceres for, regardless of industry.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 auto-rows-[minmax(180px,auto)]">
          <article class="md:col-span-2 border border-primary/25 bg-gradient-to-br from-surface-container to-surface-container-high p-7 flex flex-col justify-between min-h-[240px] industrial-shadow">
            <div class="flex items-center justify-between gap-4 mb-8">
              <span class="material-symbols-outlined text-primary text-3xl">warning</span>
              <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary border border-primary/20 px-2 py-1">Priority first</span>
            </div>
            <div>
              <h3 class="text-on-surface mb-3">Exception management</h3>
              <p class="text-on-surface-variant max-w-none">Catch the changes, anomalies, and exposures that are easy to miss in manual review, then push the next action back into your workflow.</p>
            </div>
          </article>
          <article class="border border-outline-variant/20 bg-surface-container p-6">
            <span class="material-symbols-outlined text-primary text-3xl mb-5">query_stats</span>
            <h3 class="text-on-surface mb-3">Risk scoring</h3>
            <p class="text-on-surface-variant">Rank suppliers, SKUs, facilities, assets, or portfolios so your team knows where to look first.</p>
          </article>
          <article class="border border-outline-variant/20 bg-surface-container p-6">
            <span class="material-symbols-outlined text-primary text-3xl mb-5">fact_check</span>
            <h3 class="text-on-surface mb-3">Explainable outputs</h3>
            <p class="text-on-surface-variant">Show the signal behind each flag so planners, operators, and analysts can defend the decision.</p>
          </article>
          <article class="border border-outline-variant/20 bg-surface-container p-6">
            <span class="material-symbols-outlined text-primary text-3xl mb-5">science</span>
            <h3 class="text-on-surface mb-3">Scenario modeling</h3>
            <p class="text-on-surface-variant">Test the likely impact of tariffs, shortages, weather shifts, and demand changes before you commit.</p>
          </article>
          <article class="md:col-span-2 border border-outline-variant/20 bg-surface-container p-6 relative overflow-hidden">
            <img src={`${import.meta.env.BASE_URL}images/feature-supply-chain.jpg`} alt="Supply chain analysis view" class="absolute inset-0 w-full h-full object-cover opacity-20" width="1200" height="700" />
            <div class="absolute inset-0 bg-gradient-to-r from-surface to-surface/70"></div>
            <div class="relative max-w-xl">
              <span class="material-symbols-outlined text-primary text-3xl mb-5">lan</span>
              <h3 class="text-on-surface mb-3">Multi-tier mapping</h3>
              <p class="text-on-surface-variant max-w-none">Go beyond the direct vendor or immediate data source you already know, and trace exposure across more of the network behind the decision.</p>
            </div>
          </article>
          <article class="border border-outline-variant/20 bg-surface-container p-6">
            <span class="material-symbols-outlined text-primary text-3xl mb-5">integration_instructions</span>
            <h3 class="text-on-surface mb-3">Planner workflow fit</h3>
            <p class="text-on-surface-variant">Keep the context, scoring, and alerts close to the tools your team already uses instead of adding another disconnected dashboard.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-surface-container-lowest px-6 py-20 border-b border-outline-variant/20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-12">
          <div class="font-mono text-[11px] tracking-[0.16em] uppercase text-primary mb-4">Example cases</div>
          <h2 class="text-on-surface mb-5">The same intelligence layer, adapted to different decisions.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <a href={industryLinks.pharma} class="group relative min-h-[320px] border border-outline-variant/20 overflow-hidden bg-surface-container">
            <img src={`${import.meta.env.BASE_URL}images/industry-manufacturing.jpg`} alt="Pharmaceutical manufacturing" class="absolute inset-0 w-full h-full object-cover opacity-35 group-hover:opacity-45 transition-opacity" width="700" height="900" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/65 to-transparent"></div>
            <div class="relative p-6 h-full flex flex-col justify-end">
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">Pharma</div>
              <h3 class="text-on-surface mb-3">Map external disruption risk onto suppliers, purchase orders, and SKUs.</h3>
              <p class="text-on-surface-variant max-w-none">Spot raw material, logistics, and geopolitical risk earlier so your team has more time to respond.</p>
            </div>
          </a>
          <a href={industryLinks.hospitals} class="group relative min-h-[320px] border border-outline-variant/20 overflow-hidden bg-surface-container">
            <img src={`${import.meta.env.BASE_URL}images/feature-dashboard.jpg`} alt="Hospital supply chain dashboard" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" width="700" height="900" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/65 to-transparent"></div>
            <div class="relative p-6 h-full flex flex-col justify-end">
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">Hospitals</div>
              <h3 class="text-on-surface mb-3">See upstream supplier and formulary risk before the shortage reaches your floor.</h3>
              <p class="text-on-surface-variant max-w-none">Connect each item to manufacturing, distribution, and external risk factors instead of waiting on vendor updates.</p>
            </div>
          </a>
          <a href={industryLinks.cpg} class="group relative min-h-[320px] border border-outline-variant/20 overflow-hidden bg-surface-container">
            <img src={`${import.meta.env.BASE_URL}images/industry-logistics.jpg`} alt="Consumer packaged goods logistics" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" width="700" height="900" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/65 to-transparent"></div>
            <div class="relative p-6 h-full flex flex-col justify-end">
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">CPG</div>
              <h3 class="text-on-surface mb-3">Reconcile planning with weather, commodities, and market signals.</h3>
              <p class="text-on-surface-variant max-w-none">Help commercial and supply teams work from the same external context instead of defending different assumptions.</p>
            </div>
          </a>
          <a href={industryLinks.investment} class="group relative min-h-[320px] border border-outline-variant/20 overflow-hidden bg-surface-container">
            <img src={`${import.meta.env.BASE_URL}images/federal-defense-jets.jpg`} alt="External signals and macro risk context" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity" width="700" height="900" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/65 to-transparent"></div>
            <div class="relative p-6 h-full flex flex-col justify-end">
              <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">Investment firms</div>
              <h3 class="text-on-surface mb-3">Strengthen internal models with structured external signal overlays.</h3>
              <p class="text-on-surface-variant max-w-none">Reduce manual research work and keep risk analysis closer to live conditions.</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 border-b border-outline-variant/20">
      <div class="max-w-7xl mx-auto grid gap-10 lg:grid-cols-[0.95fr_1.05fr] items-center">
        <div>
          <div class="font-mono text-[11px] tracking-[0.16em] uppercase text-primary mb-4">Why teams bring in Ceres</div>
          <h2 class="text-on-surface mb-5">You do not need to replace your stack to get earlier visibility.</h2>
          <p class="text-lg text-on-surface-variant">Ceres is an intelligence layer, not a rip-and-replace platform. It fits alongside your ERP, planning tools, and existing workflows so your team can work from better context instead of more dashboards.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="border border-outline-variant/20 bg-surface-container p-6">
            <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">Direct fit</div>
            <p class="text-on-surface-variant">Works alongside the systems your team already uses.</p>
          </div>
          <div class="border border-outline-variant/20 bg-surface-container p-6">
            <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">35,000+ indicators</div>
            <p class="text-on-surface-variant">Brings broad external context into a usable operational workflow.</p>
          </div>
          <div class="border border-outline-variant/20 bg-surface-container p-6">
            <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">Multi-tier visibility</div>
            <p class="text-on-surface-variant">Go beyond the direct vendor or immediate data source you already know.</p>
          </div>
          <div class="border border-outline-variant/20 bg-surface-container p-6">
            <div class="font-mono text-[10px] tracking-[0.16em] uppercase text-primary mb-3">Explainable by design</div>
            <p class="text-on-surface-variant">See the signal behind the recommendation before you act.</p>
          </div>
        </div>
      </div>
    </section>

