---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';
import aboutHero from '../images/about-hero.jpg';

const capabilities = [
  { icon: 'fact_check', label: 'SCORECARDS' },
  { icon: 'map', label: 'EXPOSURE MAPPING' },
  { icon: 'category', label: 'CLASSIFICATION' },
  { icon: 'trending_up', label: 'FORECASTING' },
  { icon: 'science', label: 'SCENARIO ANALYSIS' },
  { icon: 'monitoring', label: 'OPERATIONAL MONITORING', accent: true },
];

const principles = [
  'Work with what already exists',
  'Focus on the workflow',
  'Make outputs easier to explain',
  'Reduce the manual grind',
];

const leaders = [
  { name: 'Bobby Katoli', role: 'Co-Founder & CEO', href: 'https://www.linkedin.com/in/bobbykatoli/' },
  { name: 'Trey Hoobler', role: 'Co-Founder', href: 'https://www.linkedin.com/in/george-william-hoobler-iii-trey-a57bb17/' },
  { name: 'Carlos Amaral', role: 'EVP & CIO', href: 'https://www.linkedin.com/in/carlosamaral/' },
];
---

<Layout
  title="About Ceres Technology | AI Planning Engine for Enterprise Supply Chains"
  description="Ceres Technology builds AI planning software that helps enterprise teams reconcile ERP records, demand signals, and external events into decision-ready supply chain plans."
>
  <Hero
    eyebrow="Company"
    lead="Ceres was founded by operators who saw firsthand how hard it was to connect real-world events to the records and systems businesses rely on every day. We built Ceres to close that gap."
    cta={{ href: demoUrl, label: 'Book a Demo', arrow: true }}
  >
    We built Ceres to help enterprises turn outside chaos into usable decisions.
  </Hero>

  <Section tone="lowest">
    <SectionHeader eyebrow="Our Story">Built from a real operating problem</SectionHeader>
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="space-y-4 text-on-surface-variant">
        <p>Ceres was born out of sheer frustration. Founders Bobby Katoli and Trey Hoobler were managing complex coffee supply chains when the COVID-19 pandemic hit.</p>
        <p>They quickly realized that while they had plenty of internal data—ERP records, spreadsheets, historical logs—they had zero connected context regarding real-world disruptions affecting their shipments.</p>
        <p>The realization was simple but profound: businesses don't lack records; they lack the situational awareness to act on those records before it's too late.</p>
      </div>
      <Media src={aboutHero} alt="Industrial supply chain shipping containers" sizes="(min-width: 1024px) 50vw, 100vw">
        <div class="absolute inset-0 flex items-center justify-center p-6">
          <div class="border border-outline-variant/30 bg-surface/90 p-4 text-center">
            <span class="eyebrow mb-1">INCIDENT_LOG_2020</span>
            <span class="font-mono text-label-sm uppercase text-on-surface">SUPPLY_CHAIN_DISRUPTION_DETECTED</span>
          </div>
        </div>
      </Media>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="What We Believe" lead="Organizations suffer from a shortage of connected context, not a shortage of records. We build systems that bridge this gap.">
      Better decisions come from better context
    </SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <Card class="border-l-2 border-l-outline-variant">
        <h3 class="mb-3">The Old Way</h3>
        <p class="text-body-sm text-on-surface-variant">Relying on stale, disconnected spreadsheets and delayed reporting. Reacting to events after they have already impacted the bottom line.</p>
      </Card>
      <Card featured>
        <h3 class="mb-3 text-primary">The Ceres Way</h3>
        <p class="text-body-sm text-on-surface-variant">Ceres pipes live external context into your existing workflows so you can act before problems hit.</p>
      </Card>
    </div>
  </Section>

  <Section tone="lowest">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-2">
      <div>
        <span class="eyebrow mb-4">System Capabilities</span>
        <h2 class="mb-10">What the platform does</h2>
        <ul class="grid grid-cols-2 gap-2 md:grid-cols-3">
          {
            capabilities.map(({ icon, label, accent }) => (
              <li class="card flex flex-col gap-3 p-4">
                <Icon name={icon} size={24} class={accent ? 'text-primary' : 'text-outline'} />
                <span class="font-mono text-label uppercase text-on-surface">{label}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <span class="eyebrow mb-4">Operating Principles</span>
        <h2 class="mb-10">How we work</h2>
        <ol class="space-y-3">
          {
            principles.map((item, i) => (
              <li class="card flex items-center gap-4 p-5">
                <span class="font-mono text-label text-primary">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-headline text-title-sm font-bold uppercase text-on-surface">{item}</span>
              </li>
            ))
          }
        </ol>
        <Card featured class="mt-8">
          <h3 class="mb-2">Who It's For</h3>
          <p class="text-body-sm text-on-surface-variant">Teams where a missed signal has real consequences.</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <Badge tone="muted">MANUFACTURING</Badge>
            <Badge tone="muted">HEALTHCARE</Badge>
            <Badge tone="muted">LOGISTICS</Badge>
          </div>
        </Card>
      </div>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="Leadership">Command Staff</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        leaders.map(({ name, role, href }) => (
          <Card href={href} external class="flex items-center justify-between gap-4">
            <div>
              <h3 class="mb-1">{name}</h3>
              <p class="meta">{role}</p>
            </div>
            <Icon name="arrow_outward" size={22} class="card-arrow text-outline transition-all" />
          </Card>
        ))
      }
    </div>
  </Section>

  <CtaBand href={demoUrl} label="Book a Demo" lead="See how Ceres connects your data to the signals your team actually needs.">
    Want to see how Ceres could fit your team?
  </CtaBand>
</Layout>
