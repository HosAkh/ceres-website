---
import Layout from '../layouts/Layout.astro';

const demoUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL + 'book-a-demo/'
  : import.meta.env.BASE_URL + '/book-a-demo/';
---

<Layout
  title="Ceres Technology | S&OP Intelligence for Demand Planning and Procurement Teams"
  description="Ceres layers live market and supply signals onto your demand plan so S&OP teams reach consensus on shared facts — not competing assumptions."
>
  <main class="pt-14 bg-surface-container-lowest">

    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12 lg:py-24">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_90%_10%,rgba(255,182,145,0.06),transparent_38%)]"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-7">
          <div class="mb-7 inline-flex items-center gap-3 border border-outline-variant/30 bg-surface-container-high/40 px-4 py-2">
            <span class="h-2 w-2 bg-primary"></span>
            <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">S&OP intelligence layer for planning and procurement teams</span>
          </div>
          <h1 class="mb-8 max-w-3xl font-headline text-5xl font-extrabold leading-[1] tracking-[-0.02em] text-on-surface sm:text-6xl lg:text-7xl">
            Close the gap between your S&OP plan and what the market is actually doing.
          </h1>
          <p class="mb-10 max-w-2xl text-lg font-body leading-[1.65] text-on-surface-variant">
            Ceres layers live market and supply signals onto your demand plan so S&OP teams reach consensus on shared facts — not competing assumptions.
          </p>
          <a href={demoUrl} class="inline-flex w-full justify-center bg-primary px-8 py-4 font-mono text-[11px] uppercase tracking-[0.14em] text-on-primary transition-all hover:brightness-110 active:scale-95 sm:w-auto">
            Book a Demo
          </a>
        </div>

        <div class="lg:col-span-5">
          <div class="border border-secondary/40 bg-surface-container p-1 shadow-[0_0_28px_rgba(0,0,0,0.35)]">
            <div class="border border-secondary/25 bg-surface-container-lowest">
              <div class="flex items-center justify-between border-b border-secondary/30 bg-secondary/20 px-4 py-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-on-surface-variant">S&OP Intelligence Layer</span>
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-secondary">Active</span>
              </div>
              <div class="space-y-5 p-6">
                <div class="border border-outline-variant/25 bg-surface-container p-4">
                  <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-on-surface-variant">Your planning data</div>
                  <div class="flex flex-wrap gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface">
                    <span class="border border-outline-variant/30 px-2 py-1">Demand plan</span>
                    <span class="border border-outline-variant/30 px-2 py-1">Supply plan</span>
                    <span class="border border-outline-variant/30 px-2 py-1">Suppliers</span>
                    <span class="border border-outline-variant/30 px-2 py-1">POs</span>
                  </div>
                </div>
                <div class="flex items-center justify-center">
                  <span class="material-symbols-outlined text-primary">south</span>
                </div>
                <div class="border border-primary/35 bg-primary/5 p-4">
                  <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Ceres</div>
                  <div class="grid grid-cols-2 gap-3 text-sm text-on-surface">
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Demand signal enrichment</div>
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Supplier risk scoring</div>
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Consensus support</div>
                    <div class="border border-outline-variant/20 bg-surface px-3 py-2">Scenario modeling</div>
                  </div>
                </div>
                <div class="flex items-center justify-center">
                  <span class="material-symbols-outlined text-primary">south</span>
                </div>
                <div class="border border-outline-variant/25 bg-surface-container p-4">
                  <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-on-surface-variant">What your team gets</div>
                  <div class="space-y-2 text-sm text-on-surface">
                    <div>Align demand and supply on shared external context</div>
                    <div>Catch forecast and procurement exceptions earlier</div>
                    <div>Move from signal to decision inside your existing cycle</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM (kept — 3 distinct pains, concise) -->
    <section class="border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">What slows every S&OP cycle</div>
          <h2 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface">The signals exist. The problem is they never reach the plan in time.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="bg-surface-container p-6 border-l-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">table_view</span>
            <h3 class="mb-3 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Consensus Built on Stale Assumptions</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">By the time your S&OP data is cleaned, aggregated, and reviewed, the external conditions it was based on have already moved.</p>
          </div>
          <div class="bg-surface-container p-6 border-l-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">visibility</span>
            <h3 class="mb-3 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Demand and Supply Working from Different Context</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Demand planning uses one view of market conditions. Procurement uses another. Neither reflects what is actually happening upstream.</p>
          </div>
          <div class="bg-surface-container p-6 border-l-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">bolt</span>
            <h3 class="mb-3 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Procurement Acts After the Gap is Visible</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">When supply disruptions, price changes, or lead time shifts reach procurement late, the decision window has often already closed.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS (kept — 3 steps, no change) -->
    <section class="border-b border-outline-variant/20 bg-surface-container-low px-6 py-14 lg:px-12 lg:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <div class="mb-2 font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">How Ceres works</div>
            <h2 class="font-headline text-5xl font-extrabold leading-[0.95] tracking-[-0.01em] text-on-surface lg:text-6xl">How Ceres Works</h2>
          </div>
          <div class="pt-1 font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">No rip-and-replace required</div>
        </div>

        <div class="grid lg:grid-cols-3">
          <article class="border-b border-outline-variant/20 px-6 py-7 lg:border-b-0 lg:border-r lg:px-8">
            <div class="mb-2 font-mono text-5xl leading-none text-white/20">01</div>
            <h3 class="mb-3 font-headline text-4xl font-bold uppercase leading-[0.95] tracking-[0.01em] text-on-surface">Connect your planning data</h3>
            <p class="font-body text-base leading-[1.6] text-on-surface-variant">Pull in S&OP, demand, inventory, supplier, and purchase order records from your ERP and planning tools — no rip-and-replace required.</p>
          </article>

          <article class="border-b border-outline-variant/20 px-6 py-7 lg:border-b-0 lg:border-r lg:px-8">
            <div class="mb-2 font-mono text-5xl leading-none text-white/20">02</div>
            <h3 class="mb-3 font-headline text-4xl font-bold uppercase leading-[0.95] tracking-[0.01em] text-on-surface">Layer market and supply signals</h3>
            <p class="font-body text-base leading-[1.6] text-on-surface-variant">Map commodity prices, trade data, weather, logistics, and supplier intelligence onto the records that drive each planning and procurement decision.</p>
          </article>

          <article class="px-6 py-7 lg:px-8">
            <div class="mb-2 font-mono text-5xl leading-none text-white/20">03</div>
            <h3 class="mb-3 font-headline text-4xl font-bold uppercase leading-[0.95] tracking-[0.01em] text-on-surface">Align and act earlier</h3>
            <p class="font-body text-base leading-[1.6] text-on-surface-variant">Surface exceptions, score risk by SKU or supplier, and give demand and procurement teams shared context before the S&OP cycle closes.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES (kept — specific and concrete, demand-planning first) -->
    <section class="border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">What S&OP teams use Ceres for</div>
          <h2 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface">From statistical baseline to approved plan, with fewer surprises.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">trending_up</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Demand Signal Enrichment</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Add weather, macroeconomic, and market signals to your statistical forecast before the review cycle so adjustments reflect what is actually happening.</p>
          </div>
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">query_stats</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Procurement Risk Scoring</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Rank suppliers and categories by exposure to commodity swings, lead time risk, and geopolitical disruption so procurement knows where to act first.</p>
          </div>
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">handshake</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">S&OP Consensus Support</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Give demand and supply a shared external view so teams stop debating assumptions and start aligning on what the data actually shows.</p>
          </div>
          <div class="bg-surface-container p-6 border-b-2 border-outline-variant/30 hover:border-primary transition-colors">
            <span class="material-symbols-outlined mb-4 text-primary">science</span>
            <h3 class="mb-2 font-headline font-bold uppercase tracking-[0.015em] text-on-surface">Scenario Modeling</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Test the impact of demand shifts, supply constraints, or cost changes on your plan before you commit — so the S&OP cycle surfaces risk, not just history.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPLORE USE CASES (compact row, replaces the 3 full image panels) -->
    <section class="border-b border-outline-variant/20 bg-surface-container-lowest px-6 py-14 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 max-w-2xl">
          <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Explore by use case</div>
          <h2 class="font-headline text-2xl font-extrabold tracking-[-0.01em] text-on-surface">See how Ceres fits your specific role.</h2>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'enterprise-console/' : import.meta.env.BASE_URL + '/enterprise-console/'} class="group flex items-center justify-between border border-outline-variant/30 bg-surface-container px-6 py-5 transition-all hover:border-primary hover:bg-surface-container-high">
            <div>
              <div class="font-mono text-[9px] uppercase tracking-[0.2em] text-on-surface-variant mb-1">S&OP</div>
              <div class="font-headline font-bold text-on-surface text-sm uppercase tracking-[0.01em]">Enterprise Console</div>
            </div>
            <span class="material-symbols-outlined text-primary text-lg transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'cpg/' : import.meta.env.BASE_URL + '/cpg/'} class="group flex items-center justify-between border border-outline-variant/30 bg-surface-container px-6 py-5 transition-all hover:border-primary hover:bg-surface-container-high">
            <div>
              <div class="font-mono text-[9px] uppercase tracking-[0.2em] text-on-surface-variant mb-1">Demand Planning</div>
              <div class="font-headline font-bold text-on-surface text-sm uppercase tracking-[0.01em]">CPG & Consumer</div>
            </div>
            <span class="material-symbols-outlined text-primary text-lg transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
          <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL + 'pharma/' : import.meta.env.BASE_URL + '/pharma/'} class="group flex items-center justify-between border border-outline-variant/30 bg-surface-container px-6 py-5 transition-all hover:border-primary hover:bg-surface-container-high">
            <div>
              <div class="font-mono text-[9px] uppercase tracking-[0.2em] text-on-surface-variant mb-1">Procurement</div>
              <div class="font-headline font-bold text-on-surface text-sm uppercase tracking-[0.01em]">Pharma & Life Sciences</div>
            </div>
            <span class="material-symbols-outlined text-primary text-lg transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ (2 specific questions only — removed the 2 that restate How It Works) -->
    <section class="border-b border-outline-variant/20 bg-surface-container-lowest p-8 lg:p-24">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-xl font-headline font-extrabold uppercase tracking-[-0.01em] mb-12 md:text-2xl">Common Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-x-16">
          <div class="md:max-w-[34rem]">
            <h6 class="text-lg md:text-xl font-headline font-bold uppercase tracking-[0.015em] mb-3 text-primary">What external signals does Ceres use for demand planning?</h6>
            <p class="max-w-none text-sm font-body font-normal text-on-surface-variant leading-[1.7]">We draw on weather forecasts, macroeconomic indicators, consumer sentiment, trade data, and category-specific market signals. Each signal is mapped to the SKUs, regions, or channels it is most likely to affect — so your statistical baseline gets relevant context, not noise.</p>
          </div>
          <div class="md:ml-auto md:max-w-[34rem]">
            <h6 class="text-lg md:text-xl font-headline font-bold uppercase tracking-[0.015em] mb-3 text-primary">How does Ceres help procurement teams specifically?</h6>
            <p class="max-w-none text-sm font-body font-normal text-on-surface-variant leading-[1.7]">Ceres monitors commodity prices, supplier financial health, lead time signals, and geopolitical indicators. It scores risk by supplier and category so procurement knows which items need attention before a gap appears on a purchase order.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#0B0E14] px-6 py-28 text-center lg:px-12">
      <div class="mx-auto max-w-4xl">
        <div class="mb-4 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Next step</div>
        <h2 class="mb-6 font-headline font-extrabold tracking-[-0.01em] text-on-surface leading-none">Bring your S&OP data. We will show you where external signals change the plan.</h2>
        <p class="mx-auto mb-10 max-w-2xl text-lg font-body leading-[1.7] text-on-surface-variant">
          Book a demo to see how Ceres maps market and supply signals onto your demand and procurement records, where your current S&OP cycle is losing time, and what your team could catch a cycle earlier.
        </p>
        <a href={demoUrl} class="inline-block bg-primary px-12 py-5 font-mono text-[11px] uppercase tracking-[0.14em] text-on-primary transition-all hover:brightness-110 active:scale-95">
          Book a Demo
        </a>
      </div>
    </section>
  </main>
</Layout>
