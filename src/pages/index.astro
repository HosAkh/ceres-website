---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import Panel from '../components/Panel.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl, withBase } from '../lib/paths';

const problems = [
  { icon: 'manage_search', title: 'The Grind', text: 'Demand signals land, and planners spend time reconciling, mapping, and rebuilding comparison reports in Excel before they can plan.' },
  { icon: 'notification_important', title: 'The Coverage Gap', text: 'Finding an exception is only half the work. The other half — what it does to the inventory you\'re holding and the orders you\'ve already placed — is where time and money quietly slip away.' },
  { icon: 'troubleshoot', title: 'The Static Scenario Plan', text: 'Plans are built once, on fixed assumptions. When a tariff hits or demand swings, there\'s no fast way to test how internal and external factors play out across S&OP — so you react after the change, not before it.' },
  { icon: 'sync_alt', title: 'The Reconciliation Problem', text: 'Customer signals say one thing, Sales says another, your ERP a third. Aligning production to the sales forecast means reconciling all three in Excel.' },
];

const layers = [
  { label: 'ERP', text: 'Designed for internal operations and records — and does that job well. External signals, real-time market conditions, and upstream disruptions aren\'t in scope by design.' },
  { label: 'BI / Analytics', text: 'Turns your internal data into historical trends and views. Good for understanding what\'s happened with external context — still needs to be sourced and interpreted separately.' },
];

const industries = [
  { label: 'Tier 1 Automotive', sub: 'OEM forecast reconciliation, supplier exceptions, inventory risk', path: 'tier-one/' },
  { label: 'Hospitals & Health Systems', sub: 'Formulary risk scoring, shortage early warning, tariff tracking', path: 'hospitals/' },
  { label: 'Pharmaceutical Supply Chain', sub: 'Supplier delay detection, API pricing risk, shortage monitoring', path: 'pharma/' },
  { label: 'Consumer Packaged Goods', sub: 'Forecast reconciliation, seasonal signal detection, commodity exposure', path: 'cpg/' },
  { label: 'Investment Research', sub: 'External signal enrichment for internal models, exposure mapping, risk scoring', path: 'investment-firms/' },
];

const faqs = [
  { q: 'What is Ceres?', a: 'Ceres is an AI planning engine for enterprise supply chain and S&OP teams. It reconciles ERP records, customer demand signals, and 10B+ external signals into one plan, and flags the exceptions that need a decision before the planning cycle closes.' },
  { q: 'Does Ceres replace our ERP or planning system?', a: 'No. Ceres works alongside SAP, Kinaxis, Blue Yonder, o9, and others. It does the reconciliation and forecasting work that otherwise lives in spreadsheets, then feeds the plan back into your system of record. No data migration required.' },
  { q: 'What external signals does Ceres monitor?', a: 'Weather and natural disasters, port and logistics pressure, raw material and commodity price movement, geopolitical and trade risk, tariff and country-of-origin changes, supplier facility disruptions, and public filings and recalls.' },
  { q: 'How does Ceres explain its outputs?', a: 'Every forecast and risk flag traces back to the specific records and external signals behind it. Analysts can interrogate any output and see the weight of every variable.' },
];

// FAQPage structured data (matches the on-page FAQ above)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is Ceres?',
      acceptedAnswer: { '@type': 'Answer', text: 'Ceres is an AI planning engine for enterprise supply chain and S&OP teams. It reconciles ERP records, customer demand signals, and 10B+ external signals into one plan, and flags the exceptions that need a decision before the planning cycle closes.' } },
    { '@type': 'Question', name: 'Does Ceres replace our ERP or planning system?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. Ceres works alongside SAP, Kinaxis, Blue Yonder, o9, and other systems. It does the reconciliation and forecasting work that otherwise lives in spreadsheets, then feeds the plan back into your system of record. No data migration is required.' } },
    { '@type': 'Question', name: 'What external signals does Ceres monitor?',
      acceptedAnswer: { '@type': 'Answer', text: 'Weather and natural disasters, port and logistics pressure, raw material and commodity price movement, geopolitical and trade risk, tariff and country-of-origin changes, supplier facility disruptions, and public filings and recalls.' } },
    { '@type': 'Question', name: 'How does Ceres explain its outputs?',
      acceptedAnswer: { '@type': 'Answer', text: 'Every forecast and risk flag is traceable to the specific internal records and external signals behind it. Analysts can interrogate outputs, challenge assumptions, and see the weight of every variable influencing a decision.' } },
  ],
};
---

<Layout
  title="AI S&OP Planning Software for Supply Chains | Ceres"
  description="Ceres is an AI planning engine that reconciles ERP data, customer demand signals, and 10B+ external signals into one S&OP plan and flags exceptions before cycle close."
  extraSchema={faqSchema}
>
  <Hero
    eyebrow="AI Supply Chain Planning Software"
    lead="Ceres is the AI planning engine between your ERP and your decisions. It reads demand signals from every customer, reconciles them against your plan, forecasts every grain — enriched by 10B+ external signals — and flags the exceptions that need a decision, before the cycle closes."
    cta={{ href: demoUrl, label: 'Book a Demo' }}
  >
    S&OP planning done in minutes.
    <Panel slot="visual" title="Ceres Agent — Running" status="Live" dot pad={false}>
      <div class="divide-y divide-outline-variant/15 px-5">
        <div class="flex items-start gap-4 py-5">
          <Icon name="task_alt" size={20} class="mt-0.5 text-primary" />
          <div>
            <div class="mb-1 font-mono text-label uppercase text-primary">Flagged — Demand Exception</div>
            <p class="text-body-sm text-on-surface">Customer releases landed 14% above forecast on three programs. Ceres traced the ripple — 6 orders now short on inventory, 4 POs under-committed. Caught before the planning cycle.</p>
            <div class="mt-2 font-mono text-label-sm text-on-surface-variant">→ <span class="text-on-surface">Routed to Planning & Procurement</span></div>
          </div>
        </div>
        <div class="flex items-start gap-4 py-5">
          <Icon name="monitoring" size={20} class="mt-0.5 text-secondary" />
          <div>
            <div class="mb-1 font-mono text-label uppercase text-secondary">Monitoring — External Exposure</div>
            <p class="text-body-sm text-on-surface">Input costs up 8.3% over six weeks; a key lane slowing. Mapped to your plan: 4 open contracts exposed, no Q4 coverage locked. Margin impact modeled across scenarios.</p>
            <div class="mt-2 font-mono text-label-sm text-on-surface-variant">→ <span class="text-on-surface">Escalated to S&OP review — 2 days before cycle closes</span></div>
          </div>
        </div>
        <div class="flex items-start gap-4 py-5">
          <Icon name="check_circle" size={20} class="mt-0.5 text-tertiary" />
          <div>
            <div class="mb-1 font-mono text-label uppercase text-tertiary">Resolved — Plan Reconciled</div>
            <p class="text-body-sm text-on-surface">Customer signals, Sales, and ERP reconciled into one plan everyone could see. Decision logged. Cycle closed <span class="font-medium text-primary">4 days early</span>, within 1% of plan.</p>
            <div class="mt-2 font-mono text-label-sm text-on-surface-variant">→ <span class="text-on-surface">Consensus reached</span></div>
          </div>
        </div>
      </div>
    </Panel>
  </Hero>

  <Section>
    <SectionHeader lead="External signals affect your operations long before they show up internally. Ceres watches them, scores what they mean for your specific records, and routes the decision to the right person before the window closes.">
      ERP Executes. Excel Reconciles. Neither Scales for S&OP.
    </SectionHeader>
    <div class="hairline-grid lg:grid-cols-2">
      {
        problems.map(({ icon, title, text }) => (
          <div class="p-6 lg:p-8">
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-2">{title}</h3>
            <p class="text-on-surface-variant">{text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="lowest" width="narrow">
    <SectionHeader align="center" lead="Ceres sits alongside your existing stack — it doesn't replace anything. Here's how the layers work together.">
      Where Ceres fits
    </SectionHeader>
    <div class="space-y-3">
      {
        layers.map(({ label, text }) => (
          <div class="card flex flex-col gap-2 px-6 py-5 sm:flex-row sm:gap-6">
            <div class="meta w-36 shrink-0 pt-1">{label}</div>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
          </div>
        ))
      }
      <div class="flex flex-col gap-2 border border-primary/30 bg-primary/5 px-6 py-5 sm:flex-row sm:gap-6">
        <div class="meta w-36 shrink-0 pt-1 text-primary">Ceres</div>
        <p class="text-body-sm text-on-surface">Does the planning work. Ingests demand from every customer, layers on 10B+ external signals, reconciles it into one plan, forecasts every grain, and flags the exceptions that need a decision, then feeds the result back into your systems.</p>
      </div>
    </div>
    <div class="card mt-8 px-6 py-5">
      <ul class="flex flex-col gap-3 sm:flex-row sm:gap-8">
        <li class="flex items-start gap-3">
          <Icon name="check" size={20} class="mt-0.5 text-primary" />
          <span class="text-body-sm text-on-surface-variant">Works with SAP, Kinaxis, Blue Yonder, o9, and others — no replacement required.</span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="check" size={20} class="mt-0.5 text-primary" />
          <span class="text-body-sm text-on-surface-variant">No data migration. Connects to the records you already have.</span>
        </li>
      </ul>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="Industries" lead="Ceres applies across any industry where external signals affect internal decisions. Here are some of the examples.">
      Example cases
    </SectionHeader>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        industries.map(({ label, sub, path }) => (
          <Card href={withBase(path)} class="flex items-start justify-between gap-4">
            <div>
              <h3 class="mb-2">{label}</h3>
              <p class="text-body-sm text-on-surface-variant">{sub}</p>
            </div>
            <Icon name="arrow_forward" size={20} class="card-arrow mt-1 text-outline transition-all" />
          </Card>
        ))
      }
    </div>
  </Section>

  <Section tone="lowest" width="narrow">
    <SectionHeader eyebrow="FAQ">Common questions</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        faqs.map(({ q, a }) => (
          <Card>
            <h3 class="mb-3">{q}</h3>
            <p class="text-on-surface-variant">{a}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <CtaBand href={demoUrl} label="Book a Demo" lead="We'll show you how Ceres maps to your specific records, suppliers, and risk scenarios in 30 minutes.">
    See how it works in your environment.
  </CtaBand>
</Layout>
