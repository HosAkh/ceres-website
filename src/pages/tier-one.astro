---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tier 1 Automotive | Ceres Technology">
  <main class="flex-grow flex flex-col items-center justify-start w-full">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 px-8 border-b border-outline-variant overflow-hidden w-full">
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-container/20 to-transparent"></div>
        <img class="w-full h-full object-cover grayscale" alt="Modern automotive manufacturing line" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC5k5d22qBD7r4kYiVKp72Wx-AU11WKPyOGJl5dFGKtZJfHUpzOD0KdUK8LNjmaKdnU__RJdA9W1x28I2xibGHmpEC_cs1ymUhDEsSqQtjJrV_y9uYMB9FNlS3oMn0PaQvTw7UOZgRb66hLNomJDjmyO5lINBO8zmBaLo-K83zUsyBJ8GVSOZhe0QkuT2Omf5ynVnJOzMbMUH-2Q67xzs42ZcN7Bkzp2sKLn_r1OteBphgWE1WngaSEXO8zFRX3tMZWAGisIO14WCE"/>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-8 flex flex-col justify-center">
          <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary mb-4 uppercase">Tier 1 Automotive Supply Chain Planning</span>
          <h1 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface leading-none mb-8 uppercase">Your planners spend days doing what takes us minutes.</h1>
          <p class="text-lg text-on-surface-variant font-body font-normal leading-[1.7] max-w-2xl mb-10">
            Ceres is the high-fidelity planning engine that sits between your ERP and your critical decisions, reconciling OEM forecasts with supplier reality in real-time.
          </p>
          <div class="flex gap-4">
            <a href={import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL + "book-a-demo/" : import.meta.env.BASE_URL + "/book-a-demo/"} class="bg-primary text-on-primary px-8 py-4 font-bold uppercase tracking-widest text-sm hover:opacity-90 transition-all">
              Schedule a Demo
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trusted By -->
    <section class="py-12 px-8 border-b border-outline-variant bg-surface-container-lowest w-full">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-8 opacity-60 grayscale hover:grayscale-0 transition-all">
        <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-outline-variant uppercase">Strategic Partners & OEM Integrations</span>
        <div class="flex gap-16 items-center">
          <div class="text-2xl font-black text-on-surface-variant font-headline tracking-tighter">BOSCH</div>
          <div class="text-2xl font-black text-on-surface-variant font-headline tracking-tighter italic">ALPS ALPINE</div>
        </div>
      </div>
    </section>

    <!-- The Problem (Bento Grid Style) -->
    <section class="py-24 px-8 border-b border-outline-variant w-full">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary uppercase">The Challenge</span>
          <h2 class="text-5xl font-headline font-extrabold tracking-[-0.01em] text-on-surface mt-4 uppercase">Manual reconciliation doesn't scale across dozens of OEMs.</h2>
        </div>
        <div class="grid grid-cols-12 gap-1 border-t border-l border-outline-variant">
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">dynamic_feed</span>
            <h3 class="text-2xl font-bold uppercase mb-4 font-headline">Manual Reconciliation</h3>
            <p class="text-on-surface-variant leading-[1.7]">Drowning in spreadsheets across thousands of line items from multiple OEM portals. Error-prone and outdated the moment it's finalized.</p>
          </div>
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">error</span>
            <h3 class="text-2xl font-bold uppercase mb-4 font-headline">Catching Exceptions</h3>
            <p class="text-on-surface-variant leading-[1.7]">Identifying demand spikes or supply drops shouldn't take a week of analysis. Most exceptions are found when the shortage hits the line.</p>
          </div>
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">query_stats</span>
            <h3 class="text-2xl font-bold uppercase mb-4 font-headline">Forecast Accuracy</h3>
            <p class="text-on-surface-variant leading-[1.7]">OEM forecasts are notoriously volatile. Without algorithmic reconciliation, your production schedules are built on fiction.</p>
          </div>
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">warning</span>
            <h3 class="text-2xl font-bold uppercase mb-4 font-headline">Inventory Risk</h3>
            <p class="text-on-surface-variant leading-[1.7]">Over-stocking components for uncertain orders or stock-outs on critical chips. Both kill the bottom line for Tier 1 suppliers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- The Platform (Layered Focus) -->
    <section class="py-24 px-8 bg-surface-container-lowest overflow-hidden w-full">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
          <div class="max-w-2xl">
            <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary uppercase">Architectural Advantage</span>
            <h2 class="text-5xl font-headline font-extrabold tracking-[-0.01em] text-on-surface mt-4 uppercase">Four layers that SAP and Excel don't give you.</h2>
          </div>
          <div class="text-right">
            <div class="flex items-center gap-2 mb-2 justify-end">
              <div class="w-3 h-3 bg-primary rounded-full animate-pulse"></div>
              <span class="font-mono text-[11px] tracking-[0.08em] text-primary uppercase">System Health: Optimal</span>
            </div>
          </div>
        </div>
        <div class="space-y-32">
          <!-- 01 Data Vault -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-5 order-2 md:order-1">
              <span class="text-6xl font-black text-outline-variant font-headline mb-4 block">01</span>
              <h3 class="text-4xl font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">Data Vault</h3>
              <p class="text-on-surface-variant leading-[1.7] text-lg mb-8">AI-driven reliability and continuous data reconciliation. We ingest noisy OEM portal data and unify it into a single, immutable source of truth that your ERP can actually trust.</p>
              <div class="flex flex-col gap-3">
                <div class="flex items-center gap-4 text-sm font-mono text-tertiary">
                  <span class="material-symbols-outlined text-primary">database</span> 
                  AUTOMATED PORTAL SCRAPING
                </div>
                <div class="flex items-center gap-4 text-sm font-mono text-tertiary">
                  <span class="material-symbols-outlined text-primary">rebase_edit</span> 
                  SCHEMA MAPPING FOR 50+ OEMS
                </div>
              </div>
            </div>
            <div class="col-span-12 md:col-span-7 order-1 md:order-2">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden p-4">
                <img class="w-full h-full object-cover rounded opacity-80" alt="Data visualization dashboard" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB9CMlvKdSOPOq2zXxM_d06w8dOSEjCTFHC6z21XhqsZjJrx72Lw-_rVcFBTFXSHxcMfM8ie35Yier57d-0peZ58S2jU5YQo39Pe4IZf4x3e7ks1Lkg00Jt4p3Ru5IIG5sB2OO2Z_8KX7WrY7YMst8c1AWtAde3pR8tz6aAwPbC3BlEc4wIfYdsgCJM2A-WXjXND-4vbxLo6IDVaTJuxZsQJtKOgGYTvjhExamX2MhB2Tizmji4g2p6WWKtgQz3XJxrgjyBb7qdM-E"/>
              </div>
            </div>
          </div>

          <!-- 02 Exception Management -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-7">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden relative">
                <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-60"></div>
                <img class="w-full h-full object-cover opacity-80" alt="Circuit board visualization" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA9ayJBGA3MpmqGZDuuqOt61au5wrmm5RWnB22c_HI6nb3IgNkGrepDXyDiLZnhFFwRJ39M_a5kp5Virg9sm9sFUFmt4riMptOGD4CLqFhRxaTwzUYTTVsvz1duiY6LgG8p353P1CZMBwKQLCS0lHlpiQDFrM5BuE2qVFjy6qocUa1IYtq8_5ELIiRrtm3BYTkplqPpNDNtD8zhBSvI7eszV6gPVoQC7NkzZzDsjLnyieJwXrdUqdIviaQbkqCtRHngtsaK0HGrvIs"/>
              </div>
            </div>
            <div class="col-span-12 md:col-span-5">
              <span class="text-6xl font-black text-outline-variant font-headline mb-4 block">02</span>
              <h3 class="text-4xl font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">Exception Management</h3>
              <p class="text-on-surface-variant leading-[1.7] text-lg mb-8">Signaling anomalies before damage occurs. Our engine constantly monitors for deviations in lead times, order volumes, and shipping delays, surfacing only the signals that matter.</p>
              <ul class="space-y-4">
                <li class="bg-surface-container-high border-l-4 border-primary p-4 text-sm font-mono uppercase tracking-wider">
                  Alert: 12% OEM Demand Spike in Region A
                </li>
                <li class="bg-surface-container p-4 text-sm font-mono uppercase tracking-wider opacity-60">
                  Alert: 2-Day Lead Time Delay (Logistics)
                </li>
              </ul>
            </div>
          </div>

          <!-- 03 AI Forecasting -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-5 order-2 md:order-1">
              <span class="text-6xl font-black text-outline-variant font-headline mb-4 block">03</span>
              <h3 class="text-4xl font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">AI Forecasting</h3>
              <p class="text-on-surface-variant leading-[1.7] text-lg mb-8">Every single grain gets a forecast. We reconcile bottom-up SKU demand with top-down product-group totals, ensuring financial targets and operational plans are perfectly aligned.</p>
              <div class="p-6 bg-surface-container border border-outline-variant rounded-sm">
                <div class="text-xs font-mono text-primary mb-4">RECONCILIATION ACCURACY</div>
                <div class="text-5xl font-black font-headline text-on-surface">98.4%</div>
              </div>
            </div>
            <div class="col-span-12 md:col-span-7 order-1 md:order-2">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden">
                <img class="w-full h-full object-cover opacity-80" alt="Predictive analytics visualization" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAIhPAexFxUkmA6rA6-VDDs7xMfM5VwLMSU6A0rTLbEOFlq2HbXFZeSquCVGSow8ZnSxRVXeFP2vRvijDQYGlWaMOAN4WtFF4ONOxTYp0HxGf71dZ3fyLkRdjT_08WHQlwmrPu0yDoR-PkZWq23fXSFRIXNwMkyFRjB0I1VaEo7Owb7HW5CPHPO645_kfOmmNhBEo31nzee-1hs_cL3diRvkeSmucOfwgbdtah_nNPpeaNHYtGRLXVa8PIFiPLi6ucNactTSp0BA1I"/>
              </div>
            </div>
          </div>

          <!-- 04 What-If Scenarios -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-7">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden relative">
                <img class="w-full h-full object-cover opacity-80" alt="Supply chain network simulation" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAJ1FwhclCckpWq1TUk_Xb3nPftrNprID8kwCMk9l0gWBRn2alQMUzzAmwXduHCXR_L-5__D1UFMI2KK78h0d76QsotBnsbyK8tVBFmhxLw67_3AHhg66BwdbwSLX9ZawGyZDaII6cIT9ChqkwkYtL2S61rqoFkydAZXUL4rp-oaPjDvDN4r_ieNDNrI6E8n1uv_Wbl69_4FJQ3tGU-fXE8idb7j0eFdT0NsiVYcSMkofBsnLoZwgoHIHPh2m9F-zTN5yTE1DxIa8k"/>
              </div>
            </div>
            <div class="col-span-12 md:col-span-5">
              <span class="text-6xl font-black text-outline-variant font-headline mb-4 block">04</span>
              <h3 class="text-4xl font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">What-If Scenarios</h3>
              <p class="text-on-surface-variant leading-[1.7] text-lg mb-8">Stress-test plans against real-world drivers. Instantly see the impact of new tariffs, raw material price shifts, or energy shortages on your Tier 1 margin.</p>
              <div class="grid grid-cols-2 gap-4">
                <div class="p-4 border border-outline-variant text-center">
                  <span class="material-symbols-outlined text-primary block mb-2">public</span>
                  <span class="font-mono text-[11px] tracking-[0.08em] uppercase">Tariff Impacts</span>
                </div>
                <div class="p-4 border border-outline-variant text-center">
                  <span class="material-symbols-outlined text-primary block mb-2">trending_up</span>
                  <span class="font-mono text-[11px] tracking-[0.08em] uppercase">Pricing Variance</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ecosystem -->
    <section class="py-24 px-8 border-t border-outline-variant w-full">
      <div class="max-w-7xl mx-auto text-center">
        <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary uppercase">System Compatibility</span>
        <h2 class="text-5xl font-headline font-extrabold tracking-[-0.01em] text-on-surface mt-4 mb-16 uppercase">An Intelligence Layer That Works Alongside Your Stack</h2>
        <div class="grid grid-cols-2 md:grid-cols-6 gap-8 items-center opacity-70">
          <div class="text-xl font-bold font-headline uppercase tracking-widest">SAP S/4HANA</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">SAP IBP</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">o9 Solutions</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">Kinaxis</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">Blue Yonder</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">Palantir</div>
        </div>
        <div class="mt-20 p-12 bg-surface-container-high border border-outline-variant rounded-xl max-w-4xl mx-auto relative overflow-hidden">
          <div class="absolute top-0 right-0 p-4">
            <span class="material-symbols-outlined text-primary/20 text-9xl">hub</span>
          </div>
          <h4 class="text-2xl font-bold font-headline uppercase mb-4 relative z-10">Zero Rip-and-Replace</h4>
          <p class="text-on-surface-variant leading-[1.7] max-w-2xl mx-auto relative z-10">
            Ceres doesn't replace your ERP. It fixes the messy data and complex forecasting logic that lives in spreadsheets, then feeds the optimized plan back into your system of record.
          </p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-32 px-8 w-full" style="background-color: #011E24; background-image: radial-gradient(circle at top right, rgba(243, 114, 33, 0.1), transparent 40%);">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-6xl font-headline font-extrabold tracking-[-0.01em] mb-8 text-primary uppercase">See how Ceres replaces the spreadsheet layer in 20 minutes.</h2>
        <a href={import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL + "book-a-demo/" : import.meta.env.BASE_URL + "/book-a-demo/"} class="inline-block bg-primary text-on-primary px-12 py-5 font-black uppercase tracking-widest text-lg hover:opacity-90 transition-all shadow-xl">
          Schedule a Demo
        </a>
        <p class="mt-8 font-mono text-sm uppercase tracking-widest opacity-80 text-tertiary">No commitment. Just your data, visualized correctly.</p>
      </div>
    </section>
  </main>
</Layout>
