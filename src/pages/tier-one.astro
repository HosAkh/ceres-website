---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';
import heroAutomotive from '../images/hero-automotive.jpg';
import featureDashboard from '../images/feature-dashboard.jpg';
import featureCircuit from '../images/feature-circuit.jpg';
import featureAnalytics from '../images/feature-analytics.jpg';
import featureSupplyChain from '../images/feature-supply-chain.jpg';

const challenges = [
  { icon: 'dynamic_feed', title: 'Manual Reconciliation', text: 'Drowning in spreadsheets across thousands of line items from multiple OEM portals.' },
  { icon: 'error', title: 'Catching Exceptions', text: 'Identifying demand spikes or supply drops shouldn\'t take a week of analysis.' },
  { icon: 'query_stats', title: 'Forecast Accuracy', text: 'OEM forecasts are notoriously volatile. Without algorithmic reconciliation, your production schedules can be error prone.' },
  { icon: 'warning', title: 'Inventory Risk', text: 'Over-stocking components for uncertain orders or stock-outs. Both kill the bottom line for Tier 1 suppliers.' },
];

const layers = [
  { n: '01', title: 'Data Vault', text: 'AI-driven reliability and continuous data reconciliation. We ingest noisy OEM data and unify it into a single, immutable source of truth that your ERP can actually trust.', image: featureDashboard, alt: 'Data visualization dashboard' },
  { n: '02', title: 'Exception Management', text: 'Signaling anomalies before damage occurs. Our engine constantly monitors for deviations in lead times, order volumes, and shipping delays, surfacing only the signals that matter.', image: featureCircuit, alt: 'Circuit board visualization' },
  { n: '03', title: 'AI Forecasting', text: 'Every single grain gets a forecast. AI reconciles bottom-up SKU demand with top-down product-group totals, ensuring financial targets and operational plans are aligned.', image: featureAnalytics, alt: 'Predictive analytics visualization' },
  { n: '04', title: 'What-If Scenarios', text: 'Stress-test plans against real-world drivers. Instantly see the impact of new tariffs, raw material price shifts, or energy shortages on your Tier 1 margin.', image: featureSupplyChain, alt: 'Supply chain network simulation' },
];

const systems = ['SAP S/4HANA', 'SAP IBP', 'o9 Solutions', 'Kinaxis', 'Blue Yonder', 'Palantir'];
---

<Layout
  title="Tier 1 Automotive Supply Chain Planning Software | Ceres"
  description="Ceres helps Tier 1 automotive suppliers reconcile EDI, OEM releases, SAP snapshots, and actuals into one planning baseline, then forecast part-customer-plant demand and flag exceptions."
>
  <Hero
    eyebrow="Tier 1 Automotive Supply Chain Planning"
    lead="Ceres is the AI planning engine that sits between your ERP and your critical decisions, reconciling OEM forecasts with supplier reality in real-time."
    cta={{ href: demoUrl, label: 'Schedule a Demo' }}
  >
    Your planners spend days doing what takes us minutes.
    <Media slot="visual" src={heroAutomotive} alt="Modern automotive manufacturing line" class="hidden lg:block" />
  </Hero>

  <section class="border-b border-outline-variant/20 bg-surface-container-lowest">
    <div class="container-x mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-6 py-8">
      <span class="meta">Clients</span>
      <div class="flex flex-wrap items-center gap-10">
        <span class="font-headline text-title-lg font-extrabold text-on-surface-variant">Bosch</span>
        <span class="font-headline text-title-lg font-extrabold text-on-surface-variant">Alps Alpine</span>
      </div>
    </div>
  </section>

  <Section>
    <SectionHeader eyebrow="The Challenge">Manual reconciliation doesn't scale across dozens of OEMs.</SectionHeader>
    <div class="hairline-grid md:grid-cols-2">
      {
        challenges.map(({ icon, title, text }) => (
          <div class="p-6 lg:p-8">
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-2">{title}</h3>
            <p class="text-on-surface-variant">{text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="lowest">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeader eyebrow="Architectural Advantage">Four layers that SAP and Excel don't give you.</SectionHeader>
      <Badge dot class="mb-12 self-start lg:mb-16">System Health: Optimal</Badge>
    </div>
    <div class="space-y-16 lg:space-y-24">
      {
        layers.map(({ n, title, text, image, alt }, i) => (
          <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-16">
            <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-2']}>
              <span class="stat mb-4 block text-primary">{n}</span>
              <h3 class="mb-4 text-title-lg">{title}</h3>
              <p class="text-lead text-on-surface-variant">{text}</p>
            </div>
            <Media src={image} alt={alt} aspect="video" class:list={['lg:col-span-7', i % 2 === 1 && 'lg:order-1']} sizes="(min-width: 1024px) 50vw, 100vw" />
          </div>
        ))
      }
    </div>
  </Section>

  <Section>
    <SectionHeader align="center" eyebrow="System Compatibility">An intelligence layer that works alongside your stack</SectionHeader>
    <ul class="grid grid-cols-2 gap-6 text-center md:grid-cols-3 lg:grid-cols-6">
      {
        systems.map((name) => (
          <li class="font-headline text-title font-bold uppercase tracking-widest text-on-surface-variant">{name}</li>
        ))
      }
    </ul>
    <Card pad="lg" class="relative mx-auto mt-16 max-w-4xl overflow-hidden text-center">
      <Icon name="hub" size={160} class="pointer-events-none absolute -right-8 -top-8 text-primary/10" />
      <h3 class="relative mb-4">Zero Rip-and-Replace</h3>
      <p class="relative mx-auto text-on-surface-variant">
        Ceres doesn't replace your ERP. It fixes the messy data and complex forecasting logic that lives in spreadsheets, then feeds the optimized plan back into your system of record.
      </p>
    </Card>
  </Section>

  <CtaBand href={demoUrl} label="Schedule a Demo">See how Ceres replaces the spreadsheet layer in 20 minutes.</CtaBand>
</Layout>
