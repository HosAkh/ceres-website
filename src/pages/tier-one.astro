---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tier 1 Automotive | Ceres Technology">
  <main class="flex-grow flex flex-col items-center justify-start w-full">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 px-8 border-b border-outline-variant overflow-hidden w-full">
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-container/20 to-transparent"></div>
        <img width="512" height="512" class="w-full h-full object-cover grayscale" alt="Modern automotive manufacturing line" src={`${import.meta.env.BASE_URL}images/hero-automotive.jpg`} />
      </div>
      <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-8 flex flex-col justify-center">
          <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary mb-4 uppercase">Tier 1 Automotive Supply Chain Planning</span>
          <h1 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface leading-none mb-8">
            Your planners spend days doing what takes us minutes.
          </h1>
          <p class="text-lg font-body font-normal text-on-surface-variant leading-[1.7] max-w-prose mb-10">
            Ceres is the AI planning engine that sits between your ERP and your critical decisions, reconciling OEM forecasts with supplier reality in real-time.
          </p>
          <div class="flex gap-4">
            <a href={import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL + "book-a-demo/" : import.meta.env.BASE_URL + "/book-a-demo/"} class="bg-primary text-on-primary px-8 py-4 font-mono text-[11px] tracking-[0.14em] uppercase hover:opacity-90 transition-all">
              Schedule a Demo
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trusted By -->
    <section class="py-12 px-8 border-b border-outline-variant bg-surface-container-lowest w-full">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-8 opacity-60 grayscale hover:grayscale-0 transition-all">
        <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-outline uppercase">Strategic Partners &amp; OEM Integrations</span>
        <div class="flex gap-16 items-center">
          <div class="text-2xl font-extrabold text-on-surface-variant font-headline tracking-[-0.01em]">Bosch</div>
          <div class="text-2xl font-extrabold text-on-surface-variant font-headline tracking-[-0.01em] italic">Alps Alpine</div>
        </div>
      </div>
    </section>

    <!-- The Problem (Bento Grid Style) -->
    <section class="py-24 px-8 border-b border-outline-variant w-full">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary uppercase">The Challenge</span>
          <h2 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface mt-4">Manual reconciliation doesn't scale across dozens of OEMs.</h2>
        </div>
        <div class="grid grid-cols-12 gap-1 border-t border-l border-outline-variant">
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">dynamic_feed</span>
            <h3 class="font-headline font-bold uppercase tracking-[0.015em] mb-4">Manual Reconciliation</h3>
            <p class="font-body font-normal text-on-surface-variant leading-[1.7]">Drowning in spreadsheets across thousands of line items from multiple OEM portals.</p>
          </div>
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">error</span>
            <h3 class="font-headline font-bold uppercase tracking-[0.015em] mb-4">Catching Exceptions</h3>
            <p class="font-body font-normal text-on-surface-variant leading-[1.7]">Identifying demand spikes or supply drops shouldn't take a week of analysis.</p>
          </div>
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">query_stats</span>
            <h3 class="font-headline font-bold uppercase tracking-[0.015em] mb-4">Forecast Accuracy</h3>
            <p class="font-body font-normal text-on-surface-variant leading-[1.7]">OEM forecasts are notoriously volatile. Without algorithmic reconciliation, your production schedules can be error prone.</p>
          </div>
          <div class="col-span-12 md:col-span-6 p-10 border-r border-b border-outline-variant hover:bg-surface-container-low transition-colors group">
            <span class="material-symbols-outlined text-primary text-4xl mb-6">warning</span>
            <h3 class="font-headline font-bold uppercase tracking-[0.015em] mb-4">Inventory Risk</h3>
            <p class="font-body font-normal text-on-surface-variant leading-[1.7]">Over-stocking components for uncertain orders or stock-outs. Both kill the bottom line for Tier 1 suppliers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- The Platform (Layered Focus) -->
    <section class="py-24 px-8 bg-surface-container-lowest overflow-hidden w-full">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
          <div class="max-w-2xl">
            <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary uppercase">Architectural Advantage</span>
            <h2 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface mt-4">Four layers that SAP and Excel don't give you.</h2>
          </div>
          <div class="text-right">
            <div class="flex items-center gap-2 mb-2 justify-end">
              <div class="w-3 h-3 bg-primary rounded-full animate-pulse"></div>
              <span class="font-mono text-[11px] tracking-[0.08em] text-primary uppercase">System Health: Optimal</span>
            </div>
          </div>
        </div>
        <div class="space-y-32">
          <!-- 01 Data Vault -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-5 order-2 md:order-1">
              <span class="font-mono font-light text-6xl text-on-surface-variant/30 font-headline mb-4 block data-mono">01</span>
              <h3 class="font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">Data Vault</h3>
              <p class="font-body font-normal text-on-surface-variant leading-[1.7] text-lg mb-8">AI-driven reliability and continuous data reconciliation. We ingest noisy OEM data and unify it into a single, immutable source of truth that your ERP can actually trust.</p>
            </div>
            <div class="col-span-12 md:col-span-7 order-1 md:order-2">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden p-4">
                <img loading="lazy" width="512" height="512" class="w-full h-full object-cover rounded opacity-80" alt="Data visualization dashboard" src={`${import.meta.env.BASE_URL}images/feature-dashboard.jpg`} />
              </div>
            </div>
          </div>

          <!-- 02 Exception Management -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-7">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden relative">
                <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-60"></div>
                <img loading="lazy" width="512" height="512" class="w-full h-full object-cover opacity-80" alt="Circuit board visualization" src={`${import.meta.env.BASE_URL}images/feature-circuit.jpg`} />
              </div>
            </div>
            <div class="col-span-12 md:col-span-5">
              <span class="font-mono font-light text-6xl text-on-surface-variant/30 font-headline mb-4 block data-mono">02</span>
              <h3 class="font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">Exception Management</h3>
              <p class="font-body font-normal text-on-surface-variant leading-[1.7] text-lg mb-8">Signaling anomalies before damage occurs. Our engine constantly monitors for deviations in lead times, order volumes, and shipping delays, surfacing only the signals that matter.</p>

            </div>
          </div>

          <!-- 03 AI Forecasting -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-5 order-2 md:order-1">
              <span class="font-mono font-light text-6xl text-on-surface-variant/30 font-headline mb-4 block data-mono">03</span>
              <h3 class="font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">AI Forecasting</h3>
              <p class="font-body font-normal text-on-surface-variant leading-[1.7] text-lg mb-8">Every single grain gets a forecast. AI reconciles bottom-up SKU demand with top-down product-group totals, ensuring financial targets and operational plans are aligned.</p>
            </div>
            <div class="col-span-12 md:col-span-7 order-1 md:order-2">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden">
                <img loading="lazy" width="512" height="512" class="w-full h-full object-cover opacity-80" alt="Predictive analytics visualization" src={`${import.meta.env.BASE_URL}images/feature-analytics.jpg`} />
              </div>
            </div>
          </div>

          <!-- 04 What-If Scenarios -->
          <div class="grid grid-cols-12 gap-12 items-center">
            <div class="col-span-12 md:col-span-7">
              <div class="aspect-video bg-surface-container rounded-lg border border-outline-variant overflow-hidden relative">
                <img loading="lazy" width="512" height="512" class="w-full h-full object-cover opacity-80" alt="Supply chain network simulation" src={`${import.meta.env.BASE_URL}images/feature-supply-chain.jpg`} />
              </div>
            </div>
            <div class="col-span-12 md:col-span-5">
              <span class="font-mono font-light text-6xl text-on-surface-variant/30 font-headline mb-4 block data-mono">04</span>
              <h3 class="font-headline font-extrabold tracking-[-0.01em] mb-6 uppercase">What-If Scenarios</h3>
              <p class="font-body font-normal text-on-surface-variant leading-[1.7] text-lg mb-8">Stress-test plans against real-world drivers. Instantly see the impact of new tariffs, raw material price shifts, or energy shortages on your Tier 1 margin.</p>

            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ecosystem -->
    <section class="py-24 px-8 border-t border-outline-variant w-full">
      <div class="max-w-7xl mx-auto text-center">
        <span class="font-mono text-[10px] tracking-[0.18em] font-normal text-primary uppercase">System Compatibility</span>
        <h2 class="font-headline font-extrabold tracking-[-0.01em] text-on-surface mt-4 mb-16">An intelligence layer that works alongside your stack</h2>
        <div class="grid grid-cols-2 md:grid-cols-6 gap-8 items-center opacity-70">
          <div class="text-xl font-bold font-headline uppercase tracking-widest">SAP S/4HANA</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">SAP IBP</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">o9 Solutions</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">Kinaxis</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">Blue Yonder</div>
          <div class="text-xl font-bold font-headline uppercase tracking-widest">Palantir</div>
        </div>
        <div class="mt-20 p-12 bg-surface-container-high border border-outline-variant rounded-xl max-w-4xl mx-auto relative overflow-hidden">
          <div class="absolute top-0 right-0 p-4">
            <span class="material-symbols-outlined text-primary/20 text-9xl">hub</span>
          </div>
          <h4 class="font-headline font-bold uppercase tracking-[0.015em] mb-4 relative z-10">Zero Rip-and-Replace</h4>
          <p class="font-body font-normal text-on-surface-variant leading-[1.7] max-w-prose mx-auto relative z-10">
            Ceres doesn't replace your ERP. It fixes the messy data and complex forecasting logic that lives in spreadsheets, then feeds the optimized plan back into your system of record.
          </p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-32 px-8 w-full" style="background-color: #011E24; background-image: radial-gradient(circle at top right, rgba(243, 114, 33, 0.1), transparent 40%);">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-headline font-extrabold tracking-[-0.01em] mb-8 text-primary">See how Ceres replaces the spreadsheet layer in 20 minutes.</h2>
        <a href={import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL + "book-a-demo/" : import.meta.env.BASE_URL + "/book-a-demo/"} class="inline-block bg-primary text-on-primary px-12 py-5 font-mono text-[11px] tracking-[0.14em] uppercase hover:opacity-90 transition-all shadow-xl">
          Schedule a Demo
        </a>
        <p class="mt-8 font-mono text-[10px] tracking-[0.18em] uppercase opacity-80 text-tertiary">No commitment. Just your data, visualized correctly.</p>
      </div>
    </section>
  </main>
</Layout>
