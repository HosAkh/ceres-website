---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';

const steps = [
  { title: 'We learn how your team works.', text: 'Before we show you software, we map your current operational topography. We need to understand the structural realities of your data flow.' },
  { title: 'We focus on the decision problem.', text: 'We identify the specific inflection points where your team lacks the merged context required to act definitively.' },
  { title: 'We show how Ceres can help.', text: 'A targeted demonstration mapping your specific bottlenecks to our protocol\'s capability to ingest, normalize, and surface actionable intelligence.' },
];

const testimonials = [
  { quote: '"The initial consultation wasn\'t about selling licenses; it was a diagnostic of our entire supply chain data model. By the time we saw the console, we already knew it solved our latency issue."', icon: 'factory', name: 'Director of Operations', org: 'Global Logistics Firm' },
  { quote: '"Ceres didn\'t ask us to change our existing systems. They mapped out how their protocol could sit on top and finally give our analysts a unified, trusted view of risk."', icon: 'account_balance', name: 'Head of Risk Analytics', org: 'Tier 1 Financial Institution' },
];
---

<Layout
  title="Book a Ceres Demo | AI S&OP Planning Software"
  description="See how Ceres maps to your records, suppliers, demand signals, and planning workflows in a customized demo for your enterprise environment."
>
  <Hero
    lead="A live walkthrough allows us to determine if our architecture aligns with your specific technical debt and analytical requirements before engaging in a proof of concept."
    align="start"
  >
    Book a Ceres walkthrough
    <div slot="visual" class="panel relative">
      <div aria-hidden="true" class="absolute left-0 top-0 h-0.5 w-full bg-primary"></div>
      <!-- Nutshell Form: the loader (and its hCaptcha) is fetched on the first user interaction -->
      <div class="relative min-h-[36rem] p-6 lg:p-8">
        <div id="nutshell-form-VANvYW"></div>
        <div id="nutshell-form-skeleton" aria-hidden="true" class="absolute inset-6 space-y-6 lg:inset-8">
          <div class="h-3 w-28 bg-surface-container-high"></div>
          <div class="h-10 w-full border border-outline-variant/30 bg-surface-container-highest/40"></div>
          <div class="h-3 w-24 bg-surface-container-high"></div>
          <div class="h-10 w-full border border-outline-variant/30 bg-surface-container-highest/40"></div>
          <div class="h-3 w-20 bg-surface-container-high"></div>
          <div class="h-10 w-full border border-outline-variant/30 bg-surface-container-highest/40"></div>
          <div class="h-3 w-32 bg-surface-container-high"></div>
          <div class="h-10 w-full border border-outline-variant/30 bg-surface-container-highest/40"></div>
        </div>
      </div>
      <script is:inline>
        (function(n,u,t){n[u]=n[u]||function(){(n[u].q=n[u].q||[]).push(arguments)}}(window,'Nutsheller'));
        Nutsheller('initForm', {form: 'VANvYW', instance: '373019', authToken: '', target: 'nutshell-form-VANvYW'});
        (function () {
          var loaded = false;
          var target = document.getElementById('nutshell-form-VANvYW');
          var skeleton = document.getElementById('nutshell-form-skeleton');
          new MutationObserver(function () {
            if (target.childNodes.length && skeleton) { skeleton.remove(); skeleton = null; }
          }).observe(target, { childList: true });
          function load() {
            if (loaded) return;
            loaded = true;
            var s = document.createElement('script');
            s.type = 'module';
            s.src = 'https://loader.nutshell.com/nutsheller-esm.js';
            document.head.appendChild(s);
          }
          ['scroll', 'pointerdown', 'pointermove', 'keydown', 'touchstart'].forEach(function (type) {
            window.addEventListener(type, load, { once: true, passive: true });
          });
        })();
      </script>
      <!-- End Nutshell Form -->
    </div>
  </Hero>

  <Section width="narrow">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div class="md:col-span-2">
        <SectionHeader class="mb-8 lg:mb-10">What to expect</SectionHeader>
        <div class="space-y-4">
          {
            steps.map(({ title, text }, i) => (
              <Card class="flex gap-6">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center border border-outline-variant/30 bg-surface-container-lowest font-mono text-lead font-light text-primary">
                  {String(i + 1).padStart(2, '0')}
                </div>
                <div>
                  <h3 class="mb-2">{title}</h3>
                  <p class="text-body-sm text-on-surface-variant">{text}</p>
                </div>
              </Card>
            ))
          }
        </div>
      </div>
      <div class="flex h-full flex-col justify-center border border-outline-variant/20 bg-surface-container-low p-6 lg:p-8">
        <h2 class="mb-6 flex items-center gap-2 text-title-lg">
          <Icon name="schedule" size={24} class="text-primary" />
          Why book time
        </h2>
        <p class="mb-6 text-body-sm text-on-surface-variant">
          Ceres is a structural implementation designed for complex operational environments.
        </p>
        <p class="text-body-sm text-on-surface-variant">
          Thirty minutes against your own records — suppliers, SKUs, demand feeds — tells both teams more than a slide deck ever could. You leave knowing exactly what Ceres would catch in your environment.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="lowest" width="narrow">
    <SectionHeader align="center" eyebrow="Verified Deployments">Built for teams that need clarity, trust, and practical implementation</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        testimonials.map(({ quote, icon, name, org }) => (
          <Card class="flex flex-col justify-between">
            <blockquote class="mb-8">
              <p class="text-on-surface-variant">{quote}</p>
            </blockquote>
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center border border-outline-variant bg-surface-container-highest">
                <Icon name={icon} size={22} class="text-secondary" />
              </div>
              <div>
                <p class="text-body-sm font-medium text-on-surface">{name}</p>
                <p class="meta">{org}</p>
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <section class="border-t border-outline-variant/20 bg-surface-cta py-10">
    <p class="container-x mx-auto flex max-w-none items-center justify-center gap-3 text-center font-mono text-label uppercase text-on-surface">
      <span aria-hidden="true" class="h-px w-8 shrink-0 bg-primary"></span>
      Built for serious teams with real operating needs
      <span aria-hidden="true" class="h-px w-8 shrink-0 bg-primary"></span>
    </p>
  </section>
</Layout>
