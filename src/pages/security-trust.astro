---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import Checklist from '../components/Checklist.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';

const trust = [
  'Zero-friction integration with existing operational stacks.',
  'Strict compartmentalization of sensitive enterprise data.',
  'Full auditability of every decision output and model inference.',
];

const principles = [
  { icon: 'input', title: 'Least-Friction Integration', text: 'Connects directly to required endpoints without demanding wholesale data migration.' },
  { icon: 'schema', title: 'Purpose-Built Workflows', text: 'Data is processed strictly within the context of predefined, authorized analytical tasks.' },
  { icon: 'route', title: 'Clear Input-to-Output Path', text: 'Every analytical conclusion can be traced back to its specific source vectors.' },
  { icon: 'cycle', title: 'Repeatable Analysis', text: 'Consistent models ensure that the same inputs reliably yield the same explainable outputs.' },
];

const reliability = [
  { label: 'Operational Risk Reduction', icon: 'arrow_downward', tone: 'text-outline' },
  { label: 'Compliance Audit Readiness', icon: 'check', tone: 'text-primary' },
  { label: 'Downtime Mitigation Strategies', icon: 'shield_locked', tone: 'text-outline' },
  { label: 'Failover Protocol Activation', icon: 'power', tone: 'text-primary' },
];
---

<Layout
  title="Security & Trust for Enterprise AI Planning | Ceres"
  description="Learn how Ceres protects enterprise data, separates sensitive records, and keeps AI planning outputs auditable, explainable, and operationally controlled."
>
  <Hero
    eyebrow="Security & Trust"
    lead="Ceres is built for organizations that need to merge internal records with external signals without creating new bottlenecks, black boxes, or operational risk."
    cta={{ href: demoUrl, label: 'Book a Demo', arrow: true }}
  >
    Enterprise trust starts with clear systems, controlled data flows, and outputs your teams can explain.
  </Hero>

  <Section tone="lowest">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <Card featured class="flex flex-col gap-6">
        <div class="flex items-center gap-3 border-b border-outline-variant/30 pb-4">
          <Icon name="verified_user" size={24} class="text-primary" />
          <h2 class="text-title-lg">Trust at Ceres</h2>
        </div>
        <Checklist items={trust} icon="check_box" class="text-body-sm" />
      </Card>
      <Card class="relative flex flex-col gap-6 overflow-hidden md:col-span-2">
        <Icon name="account_tree" size={140} class="pointer-events-none absolute -right-4 -top-4 text-on-surface/10" />
        <div class="relative flex items-center gap-3 border-b border-outline-variant/30 pb-4">
          <Icon name="architecture" size={24} class="text-primary" />
          <h2 class="text-title-lg">Enterprise Architecture Fit</h2>
        </div>
        <p class="relative text-body-sm text-on-surface-variant">
          Ceres sits on top of your existing ERPs, databases, and core infrastructure. It pulls in the signals you need without requiring a full data migration.
        </p>
        <div class="relative mt-auto grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-2 border border-outline-variant/20 bg-surface-container-lowest p-4">
            <span class="meta text-outline">Layer 1</span>
            <span class="font-headline text-title-sm font-bold text-on-surface">Existing ERP/DB Core</span>
          </div>
          <div class="flex flex-col gap-2 border border-outline-variant/20 border-t-2 border-t-primary bg-surface-container-lowest p-4">
            <span class="eyebrow">Layer 2</span>
            <span class="font-headline text-title-sm font-bold text-on-surface">Ceres Decision Engine</span>
          </div>
        </div>
      </Card>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="Data Governance">Data Handling Principles</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        principles.map(({ icon, title, text }) => (
          <Card>
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-2">{title}</h3>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section tone="lowest">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <Card class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <Icon name="visibility" size={24} class="text-primary" />
          <h2 class="text-title-lg">Radical Explainability</h2>
        </div>
        <p class="text-body-sm text-on-surface-variant">
          Black box AI is a liability in enterprise operations. Ceres provides transparent diagnostic tools allowing analysts to interrogate outputs, challenge assumptions, and understand the weight of every variable influencing a decision.
        </p>
        <div class="mt-auto flex items-center justify-between gap-4 border border-outline-variant/30 bg-surface-container-lowest p-4">
          <span class="meta text-outline">Every output is traceable to its source</span>
          <Icon name="verified" size={18} class="text-primary" />
        </div>
      </Card>
      <Card class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <Icon name="gavel" size={24} class="text-primary" />
          <h2 class="text-title-lg">Reliability for High-Stakes</h2>
        </div>
        <ul class="flex flex-col gap-4 text-body-sm text-on-surface-variant">
          {
            reliability.map(({ label, icon, tone }) => (
              <li class="flex items-center justify-between gap-4 border-b border-outline-variant/20 pb-3">
                <span>{label}</span>
                <Icon name={icon} size={18} class={tone} />
              </li>
            ))
          }
        </ul>
      </Card>
    </div>
  </Section>

  <CtaBand href={demoUrl} label="Book a Demo" lead="Schedule a technical review with our systems architecture team.">
    Need a closer look at how Ceres fits your environment?
  </CtaBand>
</Layout>
