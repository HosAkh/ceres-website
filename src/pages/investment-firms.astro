---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';

const capabilities = [
  { icon: 'map', title: 'Exposure Mapping', text: 'Instantly visualize portfolio exposure to emerging geopolitical or infrastructural events across multiple tiers of the supply chain.' },
  { icon: 'analytics', title: 'Due Diligence Support', text: 'Accelerate initial screening with automated dossiers that cross-reference target companies against a broad set of external data.' },
  { icon: 'timeline', title: 'Macro Overlay', text: 'Stress-test specific investments against shifting macroeconomic scenarios without leaving your core workflow environment.' },
];
---

<Layout
  title="External Signal Intelligence for Investment Research | Ceres"
  description="Ceres enriches investment research with external signal monitoring, exposure mapping, and risk scoring across companies, markets, and operating conditions."
>
  <Hero
    eyebrow="Investment Research"
    lead="Your proprietary models are only as strong as the context around them. Ceres connects your internal analyst workflows to outside market, macro, geopolitical, and infrastructure signals — automatically, without rebuilding your infrastructure."
    cta={{ href: demoUrl, label: 'Book a Demo', arrow: true }}
  >
    Merge internal models with external signals to strengthen investment research and risk analysis
  </Hero>

  <Section tone="lowest" width="narrow">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <span class="eyebrow mb-4">The Challenge</span>
        <h2>Internal models are not enough on their own</h2>
      </div>
      <p class="self-center text-on-surface-variant">
        Your models are built on internal views. Reconciling them with shifting macro conditions, geopolitical events, and infrastructure changes is a manual, error-prone process that slows every research cycle. Without structured external signal integration, risk analysis stays reactive.
      </p>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="How Ceres Helps">Connect external signals to the workflows your team already uses</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <Card class="md:col-span-2">
        <Icon name="hub" size={32} class="mb-5 text-primary" />
        <h3 class="mb-3">Model Integration Engine</h3>
        <p class="mb-6 text-body-sm text-on-surface-variant">
          Feed structured external signals directly into your proprietary research models, eliminating manual data wrangling.
        </p>
        <div class="overflow-x-auto">
          <div class="flex min-w-[360px] items-center justify-between gap-3 border border-outline-variant/20 bg-surface-container-lowest p-4 font-mono text-label-sm text-outline">
            <div class="flex shrink-0 flex-col gap-2">
              <span class="border border-outline-variant/30 bg-surface px-2 py-1">MACRO_DATA</span>
              <span class="border border-outline-variant/30 bg-surface px-2 py-1">GEO_EVENTS</span>
            </div>
            <Icon name="arrow_forward" size={20} class="text-outline" />
            <div class="shrink-0 border border-primary bg-primary/5 px-4 py-8 text-primary">CERES_API</div>
            <Icon name="arrow_forward" size={20} class="text-outline" />
            <div class="shrink-0 border border-outline-variant/30 bg-surface px-4 py-8 text-on-surface">INTERNAL_MODELS</div>
          </div>
        </div>
      </Card>
      <Card class="flex flex-col justify-between">
        <div>
          <Icon name="policy" size={32} class="mb-5 text-primary" />
          <h3 class="mb-3">Custom Scorecards</h3>
          <p class="text-body-sm text-on-surface-variant">
            Define proprietary weighting for different signal types to generate custom risk and opportunity scorecards for any asset or sector.
          </p>
        </div>
        <div class="mt-6 flex items-center justify-between border-t border-outline-variant/20 pt-4 font-mono text-label-sm text-outline">
          <span>Customisable</span>
          <span>Yes</span>
        </div>
      </Card>
      {
        capabilities.map(({ icon, title, text }) => (
          <Card>
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-3">{title}</h3>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <CtaBand
    href={demoUrl}
    label="Book a Demo"
    badge="Deployment Ready"
    lead="Automate company and market analysis. Reduce spreadsheet drudgery and keep continuous watch on the signals that matter."
  >
    Want to see how Ceres would fit your research process?
  </CtaBand>
</Layout>
