---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Investment Firms - CERES TECH">
  <main class="pt-16 min-h-screen flex flex-col">

    <!-- HERO SECTION -->
    <section class="machined-gradient border-b border-outline-variant/20 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(to right, #45474b 1px, transparent 1px), linear-gradient(to bottom, #45474b 1px, transparent 1px); background-size: 24px 24px;"></div>
      <div class="max-w-7xl mx-auto px-6 py-32 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container border border-outline-variant/30 text-primary font-mono text-[10px] uppercase tracking-[0.18em]">
            <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
            Investment Solutions
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold font-headline tracking-[-0.01em] text-white leading-none">
            Merge internal models with external signals to strengthen investment research and risk analysis
          </h1>
          <p class="text-lg font-body font-normal text-on-surface-variant max-w-2xl leading-[1.7]">
            Ceres helps investment firms connect internal models, analyst workflows, and spreadsheet analysis to outside market, macroeconomic, geopolitical, infrastructure, demographic, and company-level signals.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a href={`book-a-demo/`} class="inline-flex justify-center items-center px-6 py-4 bg-primary text-on-primary font-mono text-[11px] tracking-[0.14em] uppercase hover:bg-primary/90 transition-colors">
              Book a Demo
              <span class="material-symbols-outlined ml-2 text-lg">arrow_forward</span>
            </a>
          </div>
          <p class="text-xs text-outline font-mono border-l-2 border-outline-variant pl-4">
            Built for teams making high-stakes decisions across public markets, private markets, credit, and special situations.
          </p>
        </div>

        <!-- Technical Hero Visual -->
        <div class="lg:col-span-5 hidden lg:block">
          <div class="bg-surface-container p-6 border border-outline-variant/30 industrial-shadow relative">
            <div class="absolute top-0 right-0 p-2 text-[10px] font-mono text-outline">SYS.OPS // 0x48A</div>
            <div class="space-y-4">
              <div class="h-8 bg-surface-container-highest border border-outline-variant/20 flex items-center px-4">
                <span class="text-xs font-mono text-primary">PORTFOLIO_RISK_INDEX</span>
              </div>
              <div class="h-48 bg-surface-container-low border border-outline-variant/20 relative flex items-end overflow-hidden">
                <svg class="absolute bottom-0 w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                  <path d="M0,100 L0,70 L20,60 L40,80 L60,40 L80,50 L100,20 L100,100 Z" fill="rgba(69, 71, 75, 0.2)"></path>
                  <path d="M0,70 L20,60 L40,80 L60,40 L80,50 L100,20" fill="none" stroke="#45474b" stroke-width="2"></path>
                  <path d="M0,100 L0,90 L20,70 L40,60 L60,30 L80,20 L100,10 L100,100 Z" fill="rgba(243, 114, 33, 0.1)"></path>
                  <path d="M0,90 L20,70 L40,60 L60,30 L80,20 L100,10" fill="none" stroke="#F37221" stroke-width="2"></path>
                </svg>
                <div class="absolute top-4 right-4 flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-primary"></span>
                  <span class="text-[10px] font-mono text-primary">LIVE DATA</span>
                </div>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div class="bg-surface-container-low p-3 border border-outline-variant/20">
                  <div class="text-[10px] text-outline mb-1 font-mono">MACRO_VOL</div>
                  <div class="text-sm font-bold text-white">24.5%</div>
                </div>
                <div class="bg-surface-container-low p-3 border border-outline-variant/20">
                  <div class="text-[10px] text-outline mb-1 font-mono">GEO_RISK</div>
                  <div class="text-sm font-bold text-primary">HIGH</div>
                </div>
                <div class="bg-surface-container-low p-3 border border-outline-variant/20">
                  <div class="text-[10px] text-outline mb-1 font-mono">SIGNAL_CONF</div>
                  <div class="text-sm font-bold text-white">0.92</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE PROBLEM -->
    <section class="bg-surface-container-lowest py-24 px-6 border-b border-outline-variant/20">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
          <div>
            <h2 class="text-3xl font-extrabold font-headline tracking-[-0.01em] text-white leading-none mb-6">
              Internal models are not enough on their own
            </h2>
            <div class="h-1 w-12 bg-primary mb-8"></div>
          </div>
          <div class="text-on-surface-variant space-y-6">
            <p class="font-body font-normal leading-[1.7]">
              Investment teams spend countless hours building proprietary models, yet these models often exist in a vacuum. Reconciling internal views with external realities—shifting macroeconomic conditions, geopolitical unrest, infrastructure changes, and evolving demographic trends—is a manual, error-prone bottleneck.
            </p>
            <p class="font-body font-normal leading-[1.7]">
              Without continuous, structured integration of these external signals, risk analysis remains reactive, and due diligence is constrained by the limits of human processing power and siloed spreadsheets.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW CERES HELPS (BENTO GRID) -->
    <section class="bg-surface py-24 px-6 border-b border-outline-variant/20">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <h2 class="text-3xl font-extrabold font-headline tracking-[-0.01em] text-white leading-none mb-4 max-w-2xl">
            Connect external signals to the workflows your team already uses
          </h2>
          <p class="font-body font-normal text-on-surface-variant max-w-2xl leading-[1.7]">
            Ceres overlays complex external signals directly onto your existing models and portfolios, empowering your analysts without requiring a full infrastructure rebuild.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="md:col-span-2 bg-surface-container p-8 border border-outline-variant/30 group hover:bg-surface-container-high transition-colors">
            <span class="material-symbols-outlined text-primary text-3xl mb-6 block">hub</span>
            <h3 class="text-xl font-headline font-bold text-white tracking-[0.015em] mb-3">Model Integration Engine</h3>
            <p class="font-body font-normal text-on-surface-variant mb-6 text-sm leading-[1.7]">
              Feed structured, high-fidelity external signals directly into your proprietary research models via robust APIs, eliminating manual data wrangling.
            </p>
            <div class="h-32 border border-outline-variant/20 bg-surface-container-lowest flex items-center justify-between p-4 font-mono text-[10px] text-outline">
              <div class="flex flex-col gap-2">
                <span class="bg-surface px-2 py-1 border border-outline-variant/30">MACRO_DATA</span>
                <span class="bg-surface px-2 py-1 border border-outline-variant/30">GEO_EVENTS</span>
              </div>
              <span class="material-symbols-outlined text-outline">arrow_forward</span>
              <div class="border border-primary text-primary px-4 py-8 bg-primary/5">CERES_API</div>
              <span class="material-symbols-outlined text-outline">arrow_forward</span>
              <div class="bg-surface px-4 py-8 border border-outline-variant/30 text-white">INTERNAL_MODELS</div>
            </div>
          </div>
          <div class="bg-surface-container p-8 border border-outline-variant/30 group hover:bg-surface-container-high transition-colors flex flex-col justify-between">
            <div>
              <span class="material-symbols-outlined text-primary text-3xl mb-6 block">policy</span>
              <h3 class="text-lg font-headline font-bold text-white tracking-[0.015em] mb-3">Custom Scorecards</h3>
              <p class="font-body font-normal text-on-surface-variant text-sm leading-[1.7]">
                Define proprietary weighting for different signal types to generate custom risk and opportunity scorecards for any asset or sector.
              </p>
            </div>
            <div class="mt-6 border-t border-outline-variant/20 pt-4">
              <div class="flex justify-between items-center text-xs font-mono text-outline">
                <span>CONFIG_FLEX</span>
                <span>HIGH</span>
              </div>
            </div>
          </div>
          <div class="bg-surface-container p-8 border border-outline-variant/30 group hover:bg-surface-container-high transition-colors">
            <span class="material-symbols-outlined text-primary text-3xl mb-6 block">map</span>
            <h3 class="text-lg font-headline font-bold text-white tracking-[0.015em] mb-3">Exposure Mapping</h3>
            <p class="font-body font-normal text-on-surface-variant text-sm leading-[1.7]">
              Instantly visualize portfolio exposure to emerging geopolitical or infrastructural events across multiple tiers of the supply chain.
            </p>
          </div>
          <div class="bg-surface-container p-8 border border-outline-variant/30 group hover:bg-surface-container-high transition-colors">
            <span class="material-symbols-outlined text-primary text-3xl mb-6 block">analytics</span>
            <h3 class="text-lg font-headline font-bold text-white tracking-[0.015em] mb-3">Due Diligence Support</h3>
            <p class="font-body font-normal text-on-surface-variant text-sm leading-[1.7]">
              Accelerate initial screening with automated dossiers that cross-reference target companies against a massive corpus of external data.
            </p>
          </div>
          <div class="bg-surface-container p-8 border border-outline-variant/30 group hover:bg-surface-container-high transition-colors">
            <span class="material-symbols-outlined text-primary text-3xl mb-6 block">timeline</span>
            <h3 class="text-lg font-headline font-bold text-white tracking-[0.015em] mb-3">Macro Overlay</h3>
            <p class="font-body font-normal text-on-surface-variant text-sm leading-[1.7]">
              Stress-test specific investments against shifting macroeconomic scenarios without leaving your core workflow environment.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="machined-gradient py-24 px-6 relative border-t border-outline-variant/20">
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <span class="text-primary font-mono text-[10px] uppercase tracking-[0.18em] block mb-4 border border-primary/30 inline-block px-3 py-1 bg-surface-container-lowest">Deployment Ready</span>
        <h2 class="text-3xl md:text-4xl font-extrabold font-headline tracking-[-0.01em] text-white leading-none mb-6">
          Want to see how Ceres would fit your research process?
        </h2>
        <p class="font-body font-normal text-on-surface-variant mb-10 text-lg max-w-2xl mx-auto leading-[1.7]">
          Automate company and market analysis. Reduce spreadsheet drudgery and maintain continuous, high-fidelity monitoring of the signals that matter.
        </p>
        <a href={`book-a-demo/`} class="inline-flex justify-center items-center px-8 py-4 bg-primary text-on-primary font-mono text-[11px] tracking-[0.14em] uppercase hover:bg-primary/90 transition-colors">
          Book a Demo
        </a>
      </div>
    </section>

  </main>
</Layout>
