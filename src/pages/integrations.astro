---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';

const paths = [
  { icon: 'hub', title: 'ERP / Enterprise', text: 'Direct hooks into core operational systems to overlay predictive risk on active orders.' },
  { icon: 'api', title: 'APIs', text: 'RESTful endpoints for real-time bidirectional sync of signals and scores.' },
  { icon: 'database', title: 'Databases', text: 'Secure connections to structured data lakes and warehouses for deep historical analysis.' },
  { icon: 'dataset', title: 'CSV / Flat-file', text: 'The universal connector. Secure drop zones for bulk processing of legacy or isolated datasets.', wide: true },
  { icon: 'document_scanner', title: 'Unstructured', text: 'Ingestion of reports, contracts, and PDFs for NLP-driven risk extraction.' },
];
---

<Layout
  title="Ceres Integrations for SAP, Kinaxis, Blue Yonder & o9"
  description="Connect Ceres to SAP, Kinaxis, Blue Yonder, o9, ERP systems, and planning platforms without replacing your existing operational stack."
>
  <Hero
    eyebrow="Integrations"
    lead="Ceres sits on top of existing enterprise environments so teams can merge internal records with external signals, automate analysis, and build scorecards and scenarios without rebuilding their stack."
    cta={{ href: demoUrl, label: 'Book a Demo' }}
  >
    Connect Ceres to the systems and records you already use
  </Hero>

  <Section tone="lowest" width="narrow">
    <Card pad="lg">
      <div class="mb-6 flex items-center gap-4">
        <Icon name="route" size={32} class="text-primary" />
        <h2 class="text-title-lg">Overview: Removing Friction</h2>
      </div>
      <p class="text-on-surface-variant">
        Deploying powerful AI shouldn't require a multi-year IT restructuring project. Ceres is designed to ingest data as it exists today. We eliminate the friction of data silos, allowing you to rapidly deploy predictive models and generate actionable intelligence across your supply chain, without the massive overhead of traditional integration cycles.
      </p>
    </Card>
  </Section>

  <Section width="narrow">
    <SectionHeader eyebrow="Connectivity">Common Integration Paths</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        paths.map(({ icon, title, text, wide }) => (
          <Card class:list={[wide && 'lg:col-span-2']}>
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-2">{title}</h3>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <CtaBand href={demoUrl} label="Book a Demo" lead="Schedule a technical walkthrough with our integration specialists.">
    Want to see how Ceres would fit your environment?
  </CtaBand>
</Layout>
