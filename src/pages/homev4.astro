---
import Layout from '../layouts/Layout.astro';

const demoUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL + 'book-a-demo/'
  : import.meta.env.BASE_URL + '/book-a-demo/';
---

<Layout
  title="Ceres Technology | AI Intelligence Layer"
  description="Ceres layers 10 billion+ external signals onto your internal records — surfacing what's at risk, what needs a decision, and who should act. Works on top of your existing ERP. No replacement required."
>
  <main class="pt-14 bg-surface-container-lowest">

    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-outline-variant/20 bg-surface px-6 py-24 lg:px-12 lg:py-32">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(255,182,145,0.07),transparent_40%)]"></div>
      <div class="relative mx-auto grid max-w-7xl gap-14 lg:grid-cols-12 lg:items-center">

        <div class="lg:col-span-5">
          <div class="mb-6 inline-flex items-center gap-3 border border-primary/30 bg-primary/5 px-4 py-2">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
            </span>
            <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-primary">AI intelligence layer</span>
          </div>
          <h1 class="mb-6 font-headline text-5xl font-extrabold leading-[1.0] tracking-[-0.02em] text-on-surface sm:text-6xl lg:text-7xl">
            The world moves fast between planning cycles. Ceres keeps your team a step ahead.
          </h1>
          <p class="mb-10 max-w-lg text-lg font-body leading-[1.65] text-on-surface-variant">
            We monitor 10 billion+ external signals — geopolitical, logistics, commodity, regulatory — and connect them directly to the decisions your team is already making, so you have the full picture before you act.
          </p>
          <a href={demoUrl} class="inline-block bg-primary px-10 py-4 font-mono text-[11px] uppercase tracking-[0.14em] text-on-primary transition-all hover:brightness-110 active:scale-95">
            Book a Demo
          </a>
        </div>

        <!-- Live agent feed -->
        <div class="lg:col-span-7">
          <div class="border border-primary/20 bg-surface-container shadow-[0_0_40px_rgba(243,114,33,0.06)]">
            <div class="flex items-center justify-between border-b border-outline-variant/25 bg-surface-container-high px-5 py-3">
              <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
                <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">Ceres Agent — Running</span>
              </div>
              <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-primary">Live</span>
            </div>
            <div class="divide-y divide-outline-variant/15 px-5 py-1">
              <div class="flex items-start gap-4 py-4">
                <span class="material-symbols-outlined mt-0.5 text-[18px] text-primary">task_alt</span>
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary mb-1">Flagged — Risk detected upstream</div>
                  <p class="text-sm text-on-surface leading-[1.6]">Supplier facility in Tier 2 affected by port closure. 6 open orders at risk. Lead time impact: 11–14 days before the next planning cycle.</p>
                  <div class="mt-1.5 font-mono text-[9px] text-on-surface-variant">Action routed to <span class="text-on-surface">Procurement</span></div>
                </div>
              </div>
              <div class="flex items-start gap-4 py-4">
                <span class="material-symbols-outlined mt-0.5 text-[18px] text-secondary">monitoring</span>
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-secondary mb-1">Monitoring — Cost exposure</div>
                  <p class="text-sm text-on-surface leading-[1.6]">Input costs up 8.3% over 6 weeks. 4 open contracts exposed. No coverage locked for Q4 — categories 7, 12, 15.</p>
                  <div class="mt-1.5 font-mono text-[9px] text-on-surface-variant">Escalated to <span class="text-on-surface">Planning Review</span> — 2 days before cycle closes</div>
                </div>
              </div>
              <div class="flex items-start gap-4 py-4">
                <span class="material-symbols-outlined mt-0.5 text-[18px] text-tertiary">check_circle</span>
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-tertiary mb-1">Resolved — Decision made</div>
                  <p class="text-sm text-on-surface leading-[1.6]">Teams aligned on a shared external view. The debate about whose numbers were right was gone. Cycle closed <span class="text-primary font-semibold">4 days early</span>.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- WHAT CERES DOES -->
    <section class="border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-3 font-headline text-4xl font-extrabold tracking-[-0.01em] text-on-surface lg:text-5xl">Not a dashboard. Not a report. A layer that acts.</h2>
        <p class="mb-14 max-w-2xl text-lg text-on-surface-variant font-body leading-[1.65]">External signals affect your operations long before they show up internally. Ceres watches them, scores what they mean for your specific records, and routes the decision to the right person before the window closes.</p>

        <div class="grid gap-px lg:grid-cols-2 bg-outline-variant/15">
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">manage_search</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Maps 35,000+ external signals to your internal records</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Commodity prices, port disruptions, supplier facility events, geopolitical shifts, weather — tracked continuously against your live data. Not a generic feed. Matched to your specific suppliers, SKUs, orders, or positions.</p>
          </div>
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">notification_important</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Surfaces what actually needs a decision today</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Hundreds of signals move every day. Ceres scores and ranks them. Your team sees the handful that require action — not the hundreds that moved but don't matter to you right now.</p>
          </div>
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">troubleshoot</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Every flag is traceable to its source</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">No black boxes. When Ceres flags something, it shows you the exact signal behind it. Your team can interrogate it, challenge it, or act on it — with a full audit trail.</p>
          </div>
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">sync_alt</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Decisions feed back into your existing systems</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Ceres sits on top of your ERP, data warehouse, or internal models. No migration. No new workflow for your team to learn. The output goes back into the systems your teams already use.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHERE CERES FITS -->
    <section class="border-b border-outline-variant/20 bg-[#0a0f14] px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-3 font-headline text-4xl font-extrabold tracking-[-0.01em] text-on-surface text-center lg:text-5xl">Where Ceres fits</h2>
        <p class="mb-10 text-center font-body text-on-surface-variant leading-[1.65]">Your existing stack records and visualizes. Ceres watches what's outside it and acts on what matters.</p>
        <div class="space-y-3">
          <div class="flex items-start gap-6 border border-outline-variant/25 bg-surface-container px-6 py-5">
            <div class="w-36 shrink-0 font-mono text-[9px] uppercase tracking-[0.18em] text-on-surface-variant pt-1">ERP</div>
            <p class="text-sm text-on-surface-variant leading-[1.7]">Records what happened accurately. Doesn't see outside your four walls. Your team still has to find the gap, interpret it, and decide what to do — every cycle, manually.</p>
          </div>
          <div class="flex items-start gap-6 border border-outline-variant/25 bg-surface-container px-6 py-5">
            <div class="w-36 shrink-0 font-mono text-[9px] uppercase tracking-[0.18em] text-on-surface-variant pt-1">BI / Analytics</div>
            <p class="text-sm text-on-surface-variant leading-[1.7]">Visualizes historical data well. Someone still builds the reports, monitors the dashboards, and has to figure out what it means and who needs to act.</p>
          </div>
          <div class="flex items-start gap-6 border border-primary/30 bg-primary/5 px-6 py-5">
            <div class="w-36 shrink-0 font-mono text-[9px] uppercase tracking-[0.18em] text-primary pt-1">Ceres</div>
            <p class="text-sm text-on-surface leading-[1.7]">Monitors external signals continuously, maps them to your specific records, scores what's at risk, and routes the decision to the right person — before the problem is visible in your ERP.</p>
          </div>
        </div>
        <div class="mt-8 border border-outline-variant/25 bg-surface-container px-6 py-5">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-8">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-lg shrink-0">check</span>
              <span class="text-sm text-on-surface-variant">Works with SAP, Kinaxis, Blue Yonder, o9, and others — no replacement required.</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-lg shrink-0">check</span>
              <span class="text-sm text-on-surface-variant">No data migration. Connects to the records you already have.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section class="border-b border-outline-variant/20 bg-surface-container-lowest px-6 py-14 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Example cases</div>
        <p class="mb-8 text-sm text-on-surface-variant max-w-2xl leading-[1.7]">Ceres applies across any industry where external signals affect internal decisions. These are some of the areas where teams are using it today — and the list keeps growing.</p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { label: 'Tier 1 Automotive', sub: 'OEM forecast reconciliation, supplier exceptions, inventory risk', path: 'tier-one/' },
            { label: 'Hospitals & Health Systems', sub: 'Formulary risk scoring, shortage early warning, tariff tracking', path: 'hospitals/' },
            { label: 'Pharmaceutical Supply Chain', sub: 'Supplier delay detection, API pricing risk, shortage monitoring', path: 'pharma/' },
            { label: 'Consumer Packaged Goods', sub: 'Forecast reconciliation, seasonal signal detection, commodity exposure', path: 'cpg/' },
            { label: 'Investment Research', sub: 'External signal enrichment for internal models, exposure mapping, risk scoring', path: 'investment-firms/' },
          ].map(({ label, sub, path }) => (
            <a href={`${import.meta.env.BASE_URL}${path}`} class="group flex items-center justify-between border border-outline-variant/30 bg-surface-container px-5 py-4 transition-all hover:border-primary">
              <div>
                <div class="font-mono text-[9px] uppercase tracking-[0.18em] text-primary mb-0.5">{label}</div>
                <div class="text-sm text-on-surface-variant">{sub}</div>
              </div>
              <span class="material-symbols-outlined text-primary text-base transition-transform group-hover:translate-x-1">arrow_forward</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#05090f] px-6 py-28 text-center lg:px-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-5 font-headline text-5xl font-extrabold tracking-[-0.01em] text-on-surface leading-[1.05] lg:text-6xl">See how it works in your environment.</h2>
        <p class="mx-auto mb-10 max-w-xl text-lg font-body leading-[1.7] text-on-surface-variant">
          We'll show you how Ceres maps to your specific records, suppliers, and risk scenarios in 30 minutes.
        </p>
        <a href={demoUrl} class="inline-block bg-primary px-14 py-5 font-mono text-[11px] uppercase tracking-[0.14em] text-on-primary transition-all hover:brightness-110 active:scale-95">
          Book a Demo
        </a>
      </div>
    </section>

  </main>
</Layout>
