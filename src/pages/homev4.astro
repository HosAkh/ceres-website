---
import Layout from '../layouts/Layout.astro';

const demoUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL + 'book-a-demo/'
  : import.meta.env.BASE_URL + '/book-a-demo/';
---

<Layout
  title="Ceres Technology | The AI That Runs Your S&OP"
  description="Ceres monitors your demand plan, scores supply risk, and tells your team where to act — before the gap opens."
>
  <main class="pt-14 bg-surface-container-lowest">

    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-outline-variant/20 bg-surface px-6 py-24 lg:px-12 lg:py-32">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(255,182,145,0.07),transparent_40%)]"></div>
      <div class="relative mx-auto grid max-w-7xl gap-14 lg:grid-cols-12 lg:items-center">

        <div class="lg:col-span-5">
          <div class="mb-6 inline-flex items-center gap-3 border border-primary/30 bg-primary/5 px-4 py-2">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
            </span>
            <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-primary">Agentic supply intelligence</span>
          </div>
          <h1 class="mb-6 font-headline text-5xl font-extrabold leading-[1.0] tracking-[-0.02em] text-on-surface sm:text-6xl lg:text-7xl">
            Stop managing your supply chain.<br class="hidden lg:block" /> Let Ceres run it.
          </h1>
          <p class="mb-10 max-w-lg text-lg font-body leading-[1.65] text-on-surface-variant">
            Ceres monitors markets and supply risk mapped to your SKUs and plan — then tells your team exactly where to act, before the gap opens.
          </p>
          <a href={demoUrl} class="inline-block bg-primary px-10 py-4 font-mono text-[11px] uppercase tracking-[0.14em] text-on-primary transition-all hover:brightness-110 active:scale-95">
            Book a Demo
          </a>
        </div>

        <!-- Live agent feed -->
        <div class="lg:col-span-7">
          <div class="border border-primary/20 bg-surface-container shadow-[0_0_40px_rgba(243,114,33,0.06)]">
            <div class="flex items-center justify-between border-b border-outline-variant/25 bg-surface-container-high px-5 py-3">
              <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
                <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-on-surface-variant">Ceres Agent — Running</span>
              </div>
              <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-primary">Live</span>
            </div>
            <div class="divide-y divide-outline-variant/15 px-5 py-1">
              <div class="flex items-start gap-4 py-4">
                <span class="material-symbols-outlined mt-0.5 text-[18px] text-primary">task_alt</span>
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary mb-1">Flagged — Demand exception</div>
                  <p class="text-sm text-on-surface leading-[1.6]">SKU 4412-B: Rotterdam congestion adds 11–14 days. Q3 plan needs a 3-week pull-forward or safety stock adjustment.</p>
                  <div class="mt-1.5 font-mono text-[9px] text-on-surface-variant">Action routed to <span class="text-on-surface">Procurement</span></div>
                </div>
              </div>
              <div class="flex items-start gap-4 py-4">
                <span class="material-symbols-outlined mt-0.5 text-[18px] text-secondary">monitoring</span>
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-secondary mb-1">Monitoring — Commodity risk</div>
                  <p class="text-sm text-on-surface leading-[1.6]">Steel (HRC) +8.3% over 6 weeks. 4 open POs exposed. No contract coverage for Q4 categories 7, 12, 15.</p>
                  <div class="mt-1.5 font-mono text-[9px] text-on-surface-variant">Escalated to <span class="text-on-surface">S&OP Review</span> — 2 days before cycle closes</div>
                </div>
              </div>
              <div class="flex items-start gap-4 py-4">
                <span class="material-symbols-outlined mt-0.5 text-[18px] text-tertiary">check_circle</span>
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-tertiary mb-1">Resolved — Consensus built</div>
                  <p class="text-sm text-on-surface leading-[1.6]">Demand and supply aligned on a single external view. Meeting time: 34 min. Cycle closed <span class="text-primary font-semibold">4 days early</span>.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- WHAT CERES DOES -->
    <section class="border-b border-outline-variant/20 bg-surface px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-3 font-headline text-4xl font-extrabold tracking-[-0.01em] text-on-surface lg:text-5xl">Not a dashboard. A system that acts.</h2>
        <p class="mb-14 max-w-2xl text-lg text-on-surface-variant font-body leading-[1.65]">Your ERP records the past. Ceres watches what's happening now — and tells your team what to do about it.</p>

        <div class="grid gap-px lg:grid-cols-2 bg-outline-variant/15">
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">manage_search</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Watches 35,000+ signals — mapped to your SKUs</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Commodities, shipping, supplier health, geopolitical risk — monitored continuously against your demand plan.</p>
          </div>
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">notification_important</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Surfaces what needs a decision today</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Not a report. Ceres scores risk by SKU and supplier — your team sees the 12 things that matter, not 400 rows.</p>
          </div>
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">groups</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Aligns demand and procurement before the meeting</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">One shared view of external reality. S&OP becomes a decision meeting, not a debate about whose data is right.</p>
          </div>
          <div class="bg-surface-container p-8">
            <span class="material-symbols-outlined text-primary text-3xl mb-4 block">science</span>
            <h3 class="mb-2 font-headline text-xl font-bold text-on-surface">Models the scenario before you commit</h3>
            <p class="text-sm font-body leading-[1.7] text-on-surface-variant">Drag and adjust against your actual data. See the outcome before you sign off — no analyst required.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPARISON -->
    <section class="border-b border-outline-variant/20 bg-[#0a0f14] px-6 py-20 lg:px-12">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-10 font-headline text-4xl font-extrabold tracking-[-0.01em] text-on-surface text-center lg:text-5xl">Where Ceres fits</h2>
        <div class="space-y-3">
          <div class="flex items-center gap-6 border border-outline-variant/25 bg-surface-container px-6 py-5">
            <div class="w-40 shrink-0 font-mono text-[9px] uppercase tracking-[0.18em] text-on-surface-variant">ERP</div>
            <p class="text-sm text-on-surface-variant">Records transactions. Your team still has to find the gap and decide what to do.</p>
          </div>
          <div class="flex items-center gap-6 border border-outline-variant/25 bg-surface-container px-6 py-5">
            <div class="w-40 shrink-0 font-mono text-[9px] uppercase tracking-[0.18em] text-on-surface-variant">BI / Analytics</div>
            <p class="text-sm text-on-surface-variant">Visualizes history. Someone still has to build reports, monitor them, and interpret the result.</p>
          </div>
          <div class="flex items-center gap-6 border border-primary/30 bg-primary/5 px-6 py-5">
            <div class="w-40 shrink-0 font-mono text-[9px] uppercase tracking-[0.18em] text-primary">Ceres</div>
            <p class="text-sm text-on-surface">Monitors your plan against live signals, scores risk, flags exceptions, and routes actions to the right person — before the cycle closes.</p>
          </div>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <span class="material-symbols-outlined text-primary text-lg">check</span>
          <span class="text-sm text-on-surface-variant">Connects to your existing ERP — no replacement required.</span>
          <span class="material-symbols-outlined text-primary text-lg sm:ml-6">check</span>
          <span class="text-sm text-on-surface-variant">No code. No analysts to configure or maintain it.</span>
        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section class="border-b border-outline-variant/20 bg-surface-container-lowest px-6 py-14 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 font-mono text-[10px] uppercase tracking-[0.18em] text-primary">Where Ceres runs today</div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { label: 'Pharma & Life Sciences', sub: 'API supply, delay scoring', path: 'pharma/' },
            { label: 'Hospitals & Health Systems', sub: 'SKU exposure, shortage prevention', path: 'hospitals/' },
            { label: 'Tier 1 Automotive', sub: 'Steel, aluminum, EDI gaps', path: 'tier-one/' },
            { label: 'Consumer Packaged Goods', sub: 'Demand enrichment, commodity risk', path: 'cpg/' },
          ].map(({ label, sub, path }) => (
            <a href={`${import.meta.env.BASE_URL}${path}`} class="group flex items-center justify-between border border-outline-variant/30 bg-surface-container px-5 py-4 transition-all hover:border-primary">
              <div>
                <div class="font-mono text-[9px] uppercase tracking-[0.18em] text-primary mb-0.5">{label}</div>
                <div class="text-sm text-on-surface-variant">{sub}</div>
              </div>
              <span class="material-symbols-outlined text-primary text-base transition-transform group-hover:translate-x-1">arrow_forward</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#05090f] px-6 py-28 text-center lg:px-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-5 font-headline text-5xl font-extrabold tracking-[-0.01em] text-on-surface leading-[1.05] lg:text-6xl">See the AI work on your data.</h2>
        <p class="mx-auto mb-10 max-w-xl text-lg font-body leading-[1.7] text-on-surface-variant">
          30 minutes. We map your ERP data to live market signals and show you what's at risk right now.
        </p>
        <a href={demoUrl} class="inline-block bg-primary px-14 py-5 font-mono text-[11px] uppercase tracking-[0.14em] text-on-primary transition-all hover:brightness-110 active:scale-95">
          Book a Demo
        </a>
      </div>
    </section>

  </main>
</Layout>
