---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';
import heroData from '../images/cpg-hero-data.jpg';
import forecast from '../images/cpg-forecast.jpg';
import seasonal from '../images/cpg-seasonal.jpg';
import explainable from '../images/cpg-explainable.jpg';

const drivers = [
  { icon: 'rainy', title: 'Weather & Climate', text: 'Seasonal pattern shifts, precipitation anomalies, and temperature changes that move demand before your internal data does.' },
  { icon: 'price_change', title: 'Input Cost Volatility', text: 'Raw material, packaging, and ingredient cost movements tracked before they reach your sourcing team.' },
  { icon: 'public', title: 'Geopolitics', text: 'Mapping disruptions across trade lanes and regional conflicts before they surface in your supplier communication.' },
  { icon: 'oil_barrel', title: 'Energy & Freight', text: 'Oil and logistics cost correlations that flow through into your COGS before your ERP reflects them.' },
];

const capabilities = [
  { title: 'Forecast Reconciliation', text: 'Automatically align optimistic sales targets with external market realities and supply constraints. See where commercial and supply chain diverge — before inventory locks in.', image: forecast, alt: 'Forecast reconciliation visualization' },
  { title: 'Seasonal Signal Monitoring', text: 'Early detection of season-shifting anomalies in weather and consumption patterns weeks ahead of time. Know when this season looks different before you\'re producing for it.', image: seasonal, alt: 'Seasonal signal monitoring visualization' },
  { title: 'Explainable Outputs', text: 'Every forecast comes with a \'why\' - linked directly to specific external indicators.', image: explainable, alt: 'Explainable outputs visualization' },
];
---

<Layout
  title="AI Demand Planning for CPG Supply Chains | Ceres"
  description="Use Ceres to reconcile forecasts, detect seasonal demand signals, monitor commodity exposure, and route supply chain exceptions for consumer packaged goods teams."
>
  <Hero
    eyebrow="Consumer Packaged Goods"
    lead="While commercial teams forecast high to hit targets, Ceres layers hyper-local weather, commodity prices, and 35,000+ market signals to deliver defensible supply chain intelligence."
    cta={{ href: demoUrl, label: 'Book a Demo', arrow: true }}
  >
    Break through the forecast accuracy ceiling that's costing you inventory every season
    <Media slot="visual" src={heroData} alt="Global CPG supply chain data visualization" class="hidden lg:block">
      <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-outline-variant/30 bg-surface/90 px-5 py-4">
        <span aria-hidden="true" class="h-2.5 w-2.5 bg-primary"></span>
        <span class="font-headline text-title font-bold text-primary">Predictive Risk Detected</span>
        <span class="meta">Global CPG Distribution Node</span>
      </div>
    </Media>
  </Hero>

  <Section tone="lowest">
    <SectionHeader lead="But it's blind to the external signals driving your real demand.">
      Your ERP shows what happened. Your planners know last year's patterns. Neither tells you the season has shifted.
    </SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        drivers.map(({ icon, title, text }, i) => (
          <Card featured={i === 0}>
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-2">{title}</h3>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section tone="low">
    <SectionHeader align="center" lead="Three things your planning team can do with Ceres that they can't do in Excel.">
      Bridging the Commercial-Supply Gap
    </SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        capabilities.map(({ title, text, image, alt }) => (
          <Card class="flex flex-col">
            <h3 class="mb-3">{title}</h3>
            <p class="mb-6 flex-1 text-body-sm text-on-surface-variant">{text}</p>
            <Media src={image} alt={alt} aspect="wide" class="mt-auto" sizes="(min-width: 768px) 33vw, 100vw" />
          </Card>
        ))
      }
    </div>
  </Section>

  <Section>
    <SectionHeader>Supply Chain Intelligence Workflows</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
      <Card featured class="flex flex-col justify-between md:col-span-2 md:row-span-2">
        <div>
          <Icon name="warning" size={32} class="mb-5 text-primary" />
          <h3 class="mb-3 text-title-lg">Over-Forecast Detection</h3>
          <p class="text-lead text-on-surface-variant">We flag SKU level discrepancies where history doesn't match current market velocity.</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-2">
          <Badge dot>High Confidence</Badge>
          <Badge>Inventory Risk</Badge>
        </div>
      </Card>
      <Card class="md:col-span-2">
        <Icon name="history_toggle_off" size={32} class="mb-5 text-primary" />
        <h3 class="mb-2">When History Misleads</h3>
        <p class="text-body-sm text-on-surface-variant">See when weather, commodity, and market signals start to break from the assumptions behind your current plan.</p>
      </Card>
      <Card>
        <Icon name="pin_drop" size={32} class="mb-5 text-primary" />
        <h3 class="mb-2">Territory Demand</h3>
        <p class="text-body-sm text-on-surface-variant">Test different what-if scenarios to see how external and internal changes could impact demand.</p>
      </Card>
      <Card class="flex flex-col justify-between">
        <div>
          <Icon name="show_chart" size={32} class="mb-5 text-primary" />
          <h3 class="mb-2">10B+ Signals</h3>
          <p class="text-body-sm text-on-surface-variant">Analyze over 10B+ signals that can impact your operations.</p>
        </div>
        <div aria-hidden="true" class="mt-6 h-1 w-full bg-surface-container-highest"><div class="h-full bg-primary" style="width: 75%"></div></div>
      </Card>
    </div>
  </Section>

  <CtaBand href={demoUrl} label="Book a Demo" lead="See how Ceres works against your planning data, SKUs, and seasonal cycles.">
    Stop guessing your planning needs
  </CtaBand>
</Layout>
