---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import Panel from '../components/Panel.astro';
import Stat from '../components/Stat.astro';
import CtaBand from '../components/CtaBand.astro';
import { demoUrl } from '../lib/paths';
import heroDashboard from '../images/ec-hero-dashboard.jpg';
import manufacturing from '../images/ec-manufacturing.jpg';

const gaps = [
  { title: 'Mismatched Data', text: 'Every customer sends demand in different formats, cadences, and time horizons.' },
  { title: 'High-SKU Complexity', text: 'Managing thousands of part-customer-plant combinations crashes traditional spreadsheets.' },
  { title: 'Constant Fire Drills', text: 'Unflagged demand shifts and missing data cause severe schedule volatility.' },
];

const solutions = [
  { icon: 'input', title: 'Ingest & Normalize', text: 'Automatically pull in EDI signals, customer releases, and SAP snapshots to create one unified baseline.', outcome: 'Outcome: stop manually reconciling files' },
  { icon: 'warning', title: 'Catch Exceptions', text: 'Automatically detect new part numbers, double plannings, and anomalous demand shifts that human eyes miss.', outcome: 'Outcome: surface critical changes instantly' },
  { icon: 'psychology', title: 'AI Forecasting', text: 'Build accurate forecasts across every active part, customer, and plant combination at massive scale.', outcome: 'Outcome: never skip a planning period' },
  { icon: 'science', title: 'Test Scenarios', text: 'Model the exact operational impact of new tariffs, logistics disruptions, or material shortages.', outcome: 'Outcome: protect margins from chaos' },
];

const roi = [
  { value: '2 days → 10 sec', title: 'Time Back to Planners', text: 'What used to take a planner two days to reconcile now runs in seconds — so your team works on decisions, not data wrangling.' },
  { value: '11x', title: 'Forecast Improvement', text: 'Teams using Ceres have seen forecast accuracy improve 11x over traditional EDI-based planning — catching gaps before production locks in.' },
  { value: '$0', title: 'Avoidable Air Freight', text: 'Anomalies that used to cause $30K emergency air freight shipments get flagged automatically — before the damage is done.' },
];
---

<Layout
  title="Enterprise Decision Console | Supply Chain Command | Ceres"
  description="The Ceres Enterprise Console gives operations teams a unified command center — automated exception handling, real-time global order visibility, and AI-powered demand forecasting."
>
  <Hero
    lead="You have an ERP, but your planning still happens in fragile spreadsheets. Ceres normalizes messy customer data, catches exceptions automatically, and builds accurate AI forecasts — so you stop fighting Excel and start making decisions."
    cta={{ href: demoUrl, label: 'Book a Custom Demo' }}
  >
    Stop planning in spreadsheets. <span class="text-primary">Start making decisions.</span>
    <div slot="after" class="mt-12 grid grid-cols-3 gap-6 border-t border-outline-variant/20 pt-8">
      <Stat value="2 days" label="→ Seconds" />
      <Stat value="11x" label="Forecast Improvement" />
      <Stat value="Zero" label="Manual Reconciliation" />
    </div>
    <Panel slot="visual" title="Global Order Status" pad={false}>
      <Media src={heroDashboard} alt="Complex data visualization screen" aspect="square" class="border-0" sizes="(min-width: 1024px) 40vw, 100vw">
        <div class="absolute inset-0 p-4">
          <div class="w-48 border border-outline-variant/30 bg-surface-container/90 p-3">
            <div class="eyebrow mb-2">Demand Signals</div>
            <div aria-hidden="true" class="space-y-2">
              <div class="h-1 w-full bg-primary/20"></div>
              <div class="h-1 w-2/3 bg-primary/20"></div>
              <div class="h-1 w-3/4 bg-primary/20"></div>
            </div>
          </div>
          <div class="absolute bottom-4 right-4 border border-outline-variant/30 bg-surface-container/90 p-3">
            <div class="meta">Forecast Sync</div>
            <div class="font-mono text-title font-light text-on-surface">Active</div>
          </div>
        </div>
      </Media>
    </Panel>
  </Hero>

  <Section tone="low">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="mb-6">The costly planning gap</h2>
        <p class="mb-8 text-on-surface-variant">
          Between your SAP system and your actual supply chain decisions lies a massive gap. Right now, your team fills that gap by stitching together data by hand. When you supply multiple OEMs, manual planning breaks down.
        </p>
        <div class="space-y-6">
          {
            gaps.map(({ title, text }) => (
              <div class="flex gap-4">
                <div aria-hidden="true" class="h-10 w-0.5 shrink-0 bg-primary"></div>
                <div>
                  <h3 class="mb-1 text-title-sm">{title}</h3>
                  <p class="text-body-sm text-on-surface-variant">{text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <Card>
        <div class="flex aspect-video flex-col items-center justify-center border border-outline-variant/30 bg-surface-container-lowest p-6 text-center">
          <div class="meta mb-4 text-error">Critical: System Overload</div>
          <div aria-hidden="true" class="relative mb-3 h-2 w-full bg-error-container"><div class="absolute inset-y-0 left-0 w-full animate-pulse bg-error"></div></div>
          <div class="meta">Excel memory limit exceeded — manual override required</div>
        </div>
      </Card>
    </div>
  </Section>

  <Section>
    <SectionHeader lead="Ceres replaces your manual spreadsheets. We bring customer demand signals, ERP data, and historical demand into one intelligent system.">
      An automated planning layer
    </SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        solutions.map(({ icon, title, text, outcome }) => (
          <Card class="flex flex-col">
            <Icon name={icon} size={32} class="mb-5 text-primary" />
            <h3 class="mb-2">{title}</h3>
            <p class="mb-6 flex-grow text-body-sm text-on-surface-variant">{text}</p>
            <div class="eyebrow border-t border-outline-variant/20 pt-4">{outcome}</div>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section tone="lowest">
    <SectionHeader>Measurable ROI</SectionHeader>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        roi.map(({ value, title, text }) => (
          <Card>
            <div class="stat mb-4">{value}</div>
            <h3 class="mb-3 text-primary">{title}</h3>
            <p class="text-body-sm text-on-surface-variant">{text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section>
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <Media src={manufacturing} alt="High-precision manufacturing" sizes="(min-width: 1024px) 50vw, 100vw" />
      <div class="space-y-8">
        <h2>Built for complexity</h2>
        <p class="text-on-surface-variant">
          Ceres is not a generic tool. It is designed specifically for supplier-side manufacturers managing multiple large customers, unpredictable demand formats, and extreme part-count complexity.
        </p>
        <div class="card flex items-center gap-4 p-4">
          <Icon name="hub" size={24} class="text-outline" />
          <span class="font-mono text-label uppercase text-on-surface">Multi-OEM Environment Native</span>
        </div>
      </div>
    </div>
  </Section>

  <CtaBand href={demoUrl} label="See Ceres in action — Book a Demo" lead="See how Ceres helps planning teams move faster, catch issues earlier, and make better decisions.">
    Close the gap between your ERP and your decisions.
  </CtaBand>
</Layout>
