---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Automated Planning Layer | Ceres Technology">
  <main class="min-h-screen">

    <!-- HERO -->
    <section class="relative pt-20 pb-12 px-6 lg:px-12 border-b border-outline-variant/10">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-2 mb-6">
            <span class="w-2 h-2 bg-primary"></span>
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-primary">System Ready: Industrial Grade</span>
          </div>
          <h1 class="font-extrabold tracking-tighter text-on-surface leading-[0.9] mb-8 uppercase">
            Automate Demand Planning to Cut <span class="text-primary">Analysis Time by 95%</span>
          </h1>
          <p class="text-lg text-on-surface-variant font-medium leading-tight max-w-2xl mb-10">
            You have an ERP, but your planning still happens in fragile spreadsheets. Ceres normalizes messy customer data, catches exceptions automatically, and builds accurate AI forecasts—so you stop fighting Excel and start making decisions.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL + "book-a-demo/" : import.meta.env.BASE_URL + "/book-a-demo/"} class="bg-primary text-on-primary px-8 py-4 font-bold uppercase tracking-tight text-sm hover:brightness-110 active:scale-95 transition-all">
              Book a Custom Demo
            </a>
          </div>
          <div class="mt-16 grid grid-cols-3 gap-8 border-t border-outline-variant/20 pt-8">
            <div>
              <div class="text-2xl font-black text-on-surface">95%</div>
              <div class="text-[10px] font-bold uppercase tracking-widest text-outline">Time Compression</div>
            </div>
            <div>
              <div class="text-2xl font-black text-on-surface">2.5x</div>
              <div class="text-[10px] font-bold uppercase tracking-widest text-outline">Planner Productivity</div>
            </div>
            <div>
              <div class="text-2xl font-black text-on-surface">0ms</div>
              <div class="text-[10px] font-bold uppercase tracking-widest text-outline">Manual Reconciliation</div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 relative">
          <div class="bg-surface-container p-1 ghost-border machined-gradient">
            <div class="bg-surface-container-lowest overflow-hidden border border-outline-variant/30 relative">
              <div class="h-8 bg-surface-container-high flex items-center px-3 justify-between">
                <div class="flex gap-1.5">
                  <div class="w-2 h-2 bg-on-surface-variant/20"></div>
                  <div class="w-2 h-2 bg-on-surface-variant/20"></div>
                  <div class="w-2 h-2 bg-on-surface-variant/20"></div>
                </div>
                <span class="text-[9px] uppercase font-bold tracking-tighter text-outline">Terminal View: Planning_Layer_Active</span>
              </div>
              <div class="p-6 space-y-3 font-mono text-xs text-primary">
                <div class="text-[10px] text-outline uppercase tracking-wider mb-4">PLANNING_STREAM // LIVE</div>
                <div class="flex justify-between"><span class="text-on-surface-variant">EDI_INGEST</span><span class="text-primary">✓ NORMALIZED</span></div>
                <div class="flex justify-between"><span class="text-on-surface-variant">EXCEPTION_SCAN</span><span class="text-error">3 FLAGGED</span></div>
                <div class="flex justify-between"><span class="text-on-surface-variant">AI_FORECAST</span><span class="text-primary">✓ ACTIVE</span></div>
                <div class="flex justify-between"><span class="text-on-surface-variant">SCENARIO_A</span><span class="text-on-surface-variant">MODELING...</span></div>
                <div class="w-full bg-surface-container h-1 mt-4"><div class="bg-primary h-full w-3/4 animate-pulse"></div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE PROBLEM -->
    <section class="py-24 px-6 lg:px-12 bg-surface-container-low border-b border-outline-variant/10">
      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl font-black uppercase tracking-tighter mb-6">The Problem: <span class="text-primary">The Costly Planning Gap</span></h2>
            <p class="text-on-surface-variant font-medium leading-relaxed mb-8">
              Between your SAP system and your actual supply chain decisions lies a massive gap. Right now, your team fills that gap by stitching together data by hand. When you supply multiple OEMs, manual planning breaks down.
            </p>
            <div class="space-y-6">
              <div class="flex gap-4 group">
                <div class="h-10 w-1 bg-primary group-hover:w-2 transition-all"></div>
                <div>
                  <h4 class="font-bold uppercase tracking-tight text-on-surface text-sm">Mismatched Data</h4>
                  <p class="text-xs text-outline">Every customer sends demand in different formats, cadences, and time horizons.</p>
                </div>
              </div>
              <div class="flex gap-4 group">
                <div class="h-10 w-1 bg-primary group-hover:w-2 transition-all"></div>
                <div>
                  <h4 class="font-bold uppercase tracking-tight text-on-surface text-sm">High-SKU Complexity</h4>
                  <p class="text-xs text-outline">Managing thousands of part-customer-plant combinations crashes traditional spreadsheets.</p>
                </div>
              </div>
              <div class="flex gap-4 group">
                <div class="h-10 w-1 bg-primary group-hover:w-2 transition-all"></div>
                <div>
                  <h4 class="font-bold uppercase tracking-tight text-on-surface text-sm">Constant Fire Drills</h4>
                  <p class="text-xs text-outline">Unflagged demand shifts and missing data cause severe schedule volatility.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-surface-container-highest p-8 ghost-border">
            <div class="aspect-video bg-[#0B0E14] flex flex-col items-center justify-center p-6 border border-outline-variant/30">
              <div class="text-[10px] font-black uppercase text-error mb-4">CRITICAL SYSTEM OVERLOAD</div>
              <div class="w-full h-2 bg-error-container relative mb-2">
                <div class="absolute inset-y-0 left-0 bg-error w-full animate-pulse"></div>
              </div>
              <div class="text-[9px] font-bold text-outline uppercase tracking-widest">Excel Memory Limit Exceeded | Manual Override Required</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE SOLUTION -->
    <section class="py-24 px-6 lg:px-12 bg-surface">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <h2 class="text-3xl font-black uppercase tracking-tighter mb-4">The Solution: <span class="text-primary">An Automated Planning Layer</span></h2>
          <p class="text-on-surface-variant font-medium leading-relaxed max-w-3xl">
            Ceres replaces your manual spreadsheets. We bring customer demand signals, ERP data, and historical demand into one intelligent system.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-surface-container p-6 machined-gradient hover:bg-surface-container-high transition-colors flex flex-col">
            <span class="material-symbols-outlined text-primary mb-6">input</span>
            <h3 class="text-sm font-bold uppercase tracking-tight text-on-surface mb-3">Ingest &amp; Normalize</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed mb-6 flex-grow">Automatically pull in EDI signals, customer releases, and SAP snapshots to create one unified baseline.</p>
            <div class="text-[9px] font-black text-primary uppercase tracking-widest border-t border-outline-variant/20 pt-4">Outcome: Stop manually reconciling files</div>
          </div>
          <div class="bg-surface-container p-6 machined-gradient hover:bg-surface-container-high transition-colors flex flex-col">
            <span class="material-symbols-outlined text-primary mb-6">warning</span>
            <h3 class="text-sm font-bold uppercase tracking-tight text-on-surface mb-3">Catch Exceptions</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed mb-6 flex-grow">Automatically detect new part numbers, double plannings, and anomalous demand shifts that human eyes miss.</p>
            <div class="text-[9px] font-black text-primary uppercase tracking-widest border-t border-outline-variant/20 pt-4">Outcome: Surface critical changes instantly</div>
          </div>
          <div class="bg-surface-container p-6 machined-gradient hover:bg-surface-container-high transition-colors flex flex-col">
            <span class="material-symbols-outlined text-primary mb-6">psychology</span>
            <h3 class="text-sm font-bold uppercase tracking-tight text-on-surface mb-3">AI Forecasting</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed mb-6 flex-grow">Build accurate forecasts across every active part, customer, and plant combination at massive scale.</p>
            <div class="text-[9px] font-black text-primary uppercase tracking-widest border-t border-outline-variant/20 pt-4">Outcome: Never skip a planning period</div>
          </div>
          <div class="bg-surface-container p-6 machined-gradient hover:bg-surface-container-high transition-colors flex flex-col">
            <span class="material-symbols-outlined text-primary mb-6">science</span>
            <h3 class="text-sm font-bold uppercase tracking-tight text-on-surface mb-3">Test Scenarios</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed mb-6 flex-grow">Model the exact operational impact of new tariffs, logistics disruptions, or material shortages.</p>
            <div class="text-[9px] font-black text-primary uppercase tracking-widest border-t border-outline-variant/20 pt-4">Outcome: Protect margins from chaos</div>
          </div>
        </div>
      </div>
    </section>

    <!-- OUTCOMES -->
    <section class="py-24 px-6 lg:px-12 border-t border-outline-variant/10">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end justify-between mb-12">
          <div>
            <h2 class="text-3xl font-black uppercase tracking-tighter mb-2">The Outcomes: <span class="text-primary">Measurable ROI</span></h2>
            <div class="h-1 w-24 bg-primary"></div>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-surface-container-low p-8 border border-outline-variant/20">
            <div class="text-4xl font-black text-on-surface mb-4">95%</div>
            <h4 class="text-sm font-bold uppercase tracking-widest text-primary mb-3">Less Analysis Time</h4>
            <p class="text-xs text-on-surface-variant leading-relaxed">Eliminate the manual grind of manipulating EDI files and weekly snapshots.</p>
          </div>
          <div class="bg-surface-container-low p-8 border border-outline-variant/20">
            <div class="text-4xl font-black text-on-surface mb-4">2.5x</div>
            <h4 class="text-sm font-bold uppercase tracking-widest text-primary mb-3">Planner Productivity</h4>
            <p class="text-xs text-on-surface-variant leading-relaxed">Scale your operations and handle massive SKU complexity without adding headcount.</p>
          </div>
          <div class="bg-surface-container-low p-8 border border-outline-variant/20">
            <div class="text-4xl font-black text-on-surface mb-4">0</div>
            <h4 class="text-sm font-bold uppercase tracking-widest text-primary mb-3">Costly Surprises</h4>
            <p class="text-xs text-on-surface-variant leading-relaxed">Spot changes before they create expedited air freight, excess inventory, or capacity problems.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="py-32 px-6 bg-[#0B0E14] text-center border-t border-outline-variant/10">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl lg:text-5xl font-black tracking-tighter uppercase mb-6 leading-none">Close the gap between <br/> your ERP and your decisions.</h2>
        <p class="text-on-surface-variant font-medium text-lg mb-12 max-w-2xl mx-auto">See how Ceres helps planning teams move faster, catch issues earlier, and make better decisions.</p>
        <a href={import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL + "book-a-demo/" : import.meta.env.BASE_URL + "/book-a-demo/"} class="bg-primary text-on-primary px-12 py-5 font-black uppercase tracking-tighter text-lg hover:brightness-110 active:scale-95 transition-all inline-block">
          See Ceres in Action — Book a Demo
        </a>
        <p class="text-outline uppercase text-[9px] font-bold tracking-[0.4em] mt-12">Authorized Access Only | Industrial Protocol Required</p>
      </div>
    </section>

  </main>
</Layout>
