Options -Indexes
AddDefaultCharset UTF-8

# ── MIME types the host may not know ─────────────────────────
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
</IfModule>

# ── Force HTTPS and non-www ───────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect www to non-www (with HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.cerestech\.co$ [NC]
  RewriteRule ^(.*)$ https://cerestech.co/$1 [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ── Compression (brotli when available, gzip otherwise) ───────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ── Cache headers ─────────────────────────────────────────────
# Astro writes hashed filenames into /_astro/, so build output, images,
# icons and fonts can be cached for a year. HTML is always revalidated.
<IfModule mod_headers.c>
  Header unset Pragma
  Header unset Expires
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff|woff2|avif|webp|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Block _wordpress directory completely ──────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block _wordpress directory — redirect to homepage
  RewriteRule ^_wordpress(/.*)?$ / [R=301,L]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ── Redirect WordPress URL patterns to homepage ───────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # WordPress query string patterns (?p=, ?page_id=, ?cat=, etc.)
  RewriteCond %{QUERY_STRING} ^p=\d+ [OR]
  RewriteCond %{QUERY_STRING} ^page_id=\d+ [OR]
  RewriteCond %{QUERY_STRING} ^cat=\d+ [OR]
  RewriteCond %{QUERY_STRING} ^tag=.+ [OR]
  RewriteCond %{QUERY_STRING} ^author=\d+ [OR]
  RewriteCond %{QUERY_STRING} ^s=.+ [OR]
  RewriteCond %{QUERY_STRING} ^feed=.+
  RewriteRule .* / [R=301,L]

  # WordPress admin and system paths
  RewriteRule ^wp-admin(/.*)?$ / [R=301,L]
  RewriteRule ^wp-login\.php$ / [R=301,L]
  RewriteRule ^wp-register\.php$ / [R=301,L]
  RewriteRule ^wp-cron\.php$ / [R=301,L]
  RewriteRule ^wp-comments-post\.php$ / [R=301,L]
  RewriteRule ^wp-blog-header\.php$ / [R=301,L]
  RewriteRule ^wp-activate\.php$ / [R=301,L]
  RewriteRule ^wp-signup\.php$ / [R=301,L]
  RewriteRule ^xmlrpc\.php$ / [R=301,L]
  RewriteRule ^wp-json(/.*)?$ / [R=301,L]
  RewriteRule ^wp-content(/.*)?$ / [R=301,L]
  RewriteRule ^wp-includes(/.*)?$ / [R=301,L]

  # Old WordPress page/post slugs (known from old site)
  RewriteRule ^category(/.*)?$ / [R=301,L]
  RewriteRule ^tag(/.*)?$ / [R=301,L]
  RewriteRule ^author(/.*)?$ / [R=301,L]
  RewriteRule ^feed(/.*)?$ / [R=301,L]
  RewriteRule ^comments(/.*)?$ / [R=301,L]
  RewriteRule ^page/\d+(/.*)?$ / [R=301,L]

  # Old product/blog pages from old WordPress site
  RewriteRule ^nostradamus-ai(/.*)?$ / [R=301,L]
  RewriteRule ^data-intelligence(/.*)?$ / [R=301,L]
  RewriteRule ^blog(/.*)?$ / [R=301,L]
  RewriteRule ^news(/.*)?$ / [R=301,L]
  RewriteRule ^events(/.*)?$ / [R=301,L]
  RewriteRule ^partners(/.*)?$ / [R=301,L]
  RewriteRule ^press(/.*)?$ / [R=301,L]
  RewriteRule ^resources(/.*)?$ / [R=301,L]
  RewriteRule ^careers(/.*)?$ / [R=301,L]
  RewriteRule ^contact(/.*)?$ / [R=301,L]
  RewriteRule ^solutions(/.*)?$ / [R=301,L]
  RewriteRule ^products(/.*)?$ / [R=301,L]
  RewriteRule ^platform(/.*)?$ / [R=301,L]
  RewriteRule ^services(/.*)?$ / [R=301,L]
  RewriteRule ^privacy-policy(/.*)?$ / [R=301,L]
  RewriteRule ^terms-of-service(/.*)?$ / [R=301,L]
  RewriteRule ^terms(/.*)?$ / [R=301,L]
  RewriteRule ^sample-page(/.*)?$ / [R=301,L]

  # Catch any remaining unknown paths — redirect to homepage
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/(tier-one|pharma|hospitals|cpg|investment-firms|integrations|security-trust|about|book-a-demo|automated-planning|data-analysis|enterprise-console)(/.*)?$
  RewriteCond %{REQUEST_URI} !^/(images|icons|fonts|_astro)/
  RewriteCond %{REQUEST_URI} !^/(sitemap\.xml|robots\.txt|favicon\.ico|favicon\.png)$
  RewriteRule ^.+$ / [R=301,L]
</IfModule>
